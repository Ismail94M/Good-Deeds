            <mxGeometry x="840" y="270" width="300" height="420" as="geometry" />
          </mxCell>
        </object>
        <object id="db" label="&lt;b&gt;PostgreSQL 16 + PostGIS 3.4&lt;/b&gt;&lt;br&gt;core: outbox_events, processed_events,&lt;br&gt;audit_log, rate_limits, config_versions&lt;br&gt;identity: users, consents, doer_codes,&lt;br&gt;oauth_accounts, phone_otps, refresh_tokens,&lt;br&gt;user_devices, phone_history&lt;br&gt;deeds: qr_scans, same_act_groups, deeds,&lt;br&gt;invites, verification_events,&lt;br&gt;deed_revisions, self_logs&lt;br&gt;+ Procrastinate job schema" status="implemented" milestone="M2" source="backend/alembic/versions/2026_11_11_0000-0001_foundation.py; backend/alembic/versions/2026_11_11_1200-0002_identity.py; backend/alembic/versions/2026_11_11_1217-0003_identity_hardening.py; backend/alembic/versions/2026_11_13_0000-0004_runtime_config.py; backend/alembic/versions/2026_11_13_0100-0005_deeds.py; backend/alembic/versions/2026_11_15_0000-0006_identity_config.py" details="20 application tables. Append-only (forbid_modification trigger): audit_log, phone_history, config_versions, verification_events, deed_revisions. Deed, scan and group locations are geography(Point, 4326). config_versions holds the qr, deeds and identity namespaces.">
