        <object id="screens" label="&lt;b&gt;M2 screens&lt;/b&gt; (F2, F3, F6)&lt;br&gt;My QR: QR + ID + 6-digit code, countdown; Record a deed: hub, camera scan, ID + code, deed form, result; My deeds: detail, edit, withdraw; self-logs; profile counts; forgot password&lt;br&gt;&lt;i&gt;Not in M2: invite screens (D26), photos (D23)&lt;/i&gt;" status="implemented" milestone="M2" source="frontend/src/features/qr/MyQrPage.tsx; frontend/src/features/report/ReportHubPage.tsx; frontend/src/features/deeds/MyDeedsPage.tsx; frontend/src/features/selflog/SelfLogsPage.tsx; frontend/src/features/profile/DeedCounts.tsx; frontend/src/features/auth/ForgotPasswordPage.tsx; frontend/src/features/deeds/deedsApi.ts" details="Built from the approved Design canvases (docs/design/f2, f3, f6). Limits and copy values come from GET /api/deeds/options and the scan response, never hard-coded (D20)."><mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="740" width="340" height="120" as="geometry" /></mxCell></object>
        <mxCell id="containers-e17" value="deedsApi.ts,&lt;br&gt;identityApi.ts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.97;entryDx=0;entryDy=0;" edge="1" parent="1" source="screens" target="api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <object id="auth" label="&lt;b&gt;Auth mechanism&lt;/b&gt;&lt;br&gt;Access JWT (15 min) in memory, sent as Bearer&lt;br&gt;Refresh token: rotating httpOnly cookie gd_refresh,&lt;br&gt;path /api/auth, SameSite=Lax, stored hashed&lt;br&gt;30-day refresh, 90-day absolute session,&lt;br&gt;token_version revocation; X-Device-Id header" status="implemented" milestone="M1" source="frontend/src/lib/api.ts; backend/app/modules/identity/router.py#_set_refresh_cookie; backend/app/core/security.py; backend/app/core/config.py">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
            <mxGeometry x="340" y="520" width="340" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="api" label="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;[Python 3.12, FastAPI, SQLAlchemy 2 async]&lt;br&gt;modules: identity, deeds, media (M3), feed (M3)&lt;br&gt;&lt;br&gt;/api/health, /api/auth/*, /api/users/*&lt;br&gt;/api/scans, /api/deeds, /api/me/deeds,&lt;br&gt;/api/me/self-logs, invites (switched off, D17)&lt;br&gt;&lt;br&gt;&lt;i&gt;M3 media:&lt;/i&gt; /api/media/options, uploads (+ complete),&lt;br&gt;deeds/{id}/photos, self-logs/{id}/photos,&lt;br&gt;photos/{id} (DELETE), photos/{id}/reports&lt;br&gt;&lt;br&gt;&lt;i&gt;M3 feed:&lt;/i&gt; /api/feed (+ options, deeds/{id}, likes,&lt;br&gt;saves, shares, comments, hide/show, notices),&lt;br&gt;/api/public/deeds/{id} (no login, no-store, noindex),&lt;br&gt;/api/users/{handle}/follow, /social; /api/me/saved,&lt;br&gt;/api/me/followers, /api/me/following&lt;br&gt;&lt;br&gt;&lt;i&gt;M3 review (moderator or admin):&lt;/i&gt;&lt;br&gt;/api/admin/photo-reports, /api/admin/photos/{id}/restore,&lt;br&gt;/api/admin/comment-reports, /api/admin/comments/{id}/restore&lt;br&gt;&lt;br&gt;Postgres rate limits, limits from config rows,&lt;br&gt;outbox emit, audit log; token paths redacted" status="implemented" milestone="M3" source="backend/app/main.py; backend/app/modules/registry.py; backend/app/modules/identity/router.py; backend/app/modules/deeds/router.py; backend/app/modules/media/router.py; backend/app/modules/feed/router.py; backend/app/core/health.py; backend/app/core/ratelimit.py; backend/app/core/runtime_config.py; backend/app/core/log_redaction.py">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
            <mxGeometry x="840" y="270" width="300" height="560" as="geometry" />
          </mxCell>
        </object>
        <object id="db" label="&lt;b&gt;PostgreSQL 16 + PostGIS 3.4&lt;/b&gt;&lt;br&gt;core: outbox_events, processed_events,&lt;br&gt;audit_log, rate_limits, config_versions&lt;br&gt;identity: users, consents, doer_codes,&lt;br&gt;oauth_accounts, phone_otps, refresh_tokens,&lt;br&gt;user_devices, phone_history&lt;br&gt;deeds: qr_scans, same_act_groups, deeds (+ area_id),&lt;br&gt;invites, verification_events, deed_revisions,&lt;br&gt;self_logs, areas (M3)&lt;br&gt;media (M3): photos, photo_report_cases,&lt;br&gt;photo_reports, photo_decisions&lt;br&gt;feed (M3): feed_posts, feed_likes, feed_comments,&lt;br&gt;feed_saves, feed_shares, follows, feed_notices_seen,&lt;br&gt;feed_top_snapshots, feed_top_entries,&lt;br&gt;comment_report_cases, comment_reports, comment_decisions&lt;br&gt;+ Procrastinate job schema (head 0018)" status="implemented" milestone="M3" source="backend/alembic/versions/2026_11_11_0000-0001_foundation.py; backend/alembic/versions/2026_11_11_1200-0002_identity.py; backend/alembic/versions/2026_11_11_1217-0003_identity_hardening.py; backend/alembic/versions/2026_11_13_0000-0004_runtime_config.py; backend/alembic/versions/2026_11_13_0100-0005_deeds.py; backend/alembic/versions/2026_11_15_0000-0006_identity_config.py; backend/alembic/versions/2026_11_16_0000-0007_deeds_v2.py; backend/alembic/versions/2026_11_17_0000-0008_deeds_v3.py; backend/alembic/versions/2026_11_17_0100-0009_deeds_v4.py; backend/alembic/versions/2026_11_17_0300-0011_identity_password_reset.py; backend/alembic/versions/2026_11_17_0400-0012_identity_reset_limits.py; backend/alembic/versions/2026_11_19_0000-0013_deeds_v5.py; backend/alembic/versions/2026_11_19_0100-0014_media.py; backend/alembic/versions/2026_11_19_0200-0015_feed.py; backend/alembic/versions/2026_11_21_0000-0016_feed_top_comments.py; backend/alembic/versions/2026_11_21_0100-0017_real_ward_areas.py; backend/alembic/versions/2026_11_21_0200-0018_deeds_v6.py" details="37 application tables. Append-only (forbid_modification trigger): audit_log, phone_history, config_versions, verification_events, deed_revisions, photo_decisions, comment_decisions. M3 migrations: 0013 areas + deeds.area_id + deeds v5 (photos_enabled moved out, area_fallback_m); 0014 media tables + media v1; 0015 feed tables + feed v1 + feed_posts backfill; 0016 feed_posts.top_comment_count (L1) and feed_comments.author_deleted_at (L3). Migration 0010 does not exist.">
          <mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
            <mxGeometry x="840" y="860" width="285" height="340" as="geometry" />
          </mxCell>
        </object>
        <object id="worker" label="&lt;b&gt;Worker&lt;/b&gt; [Procrastinate] (one worker, all queues)&lt;br&gt;core.dispatch_outbox (every 5 s), core.handle_event&lt;br&gt;identity.purge_expired_records (03:17)&lt;br&gt;deeds.expire_invites (15 min), deeds.purge_unconsumed_scans (03:37)&lt;br&gt;&lt;i&gt;M3 media queue:&lt;/i&gt; media.process_queued (every 5 s),&lt;br&gt;media.move_objects (1 min), media.purge_deleted (5 min),&lt;br&gt;media.sweep_late_puts (5 min), media.expire_uploads (30 min),&lt;br&gt;media.purge_detached (hourly), media.purge_removed (02:23),&lt;br&gt;media.sweep_staging (02:53)&lt;br&gt;&lt;i&gt;M3 feed:&lt;/i&gt; feed.refresh_top (every min, per period when due),&lt;br&gt;feed.erase_deleted_comments (03:47)&lt;br&gt;handlers: DeedVerified / DeedWithdrawn / DeedRejected → feed" status="implemented" milestone="M3" source="backend/app/core/jobs.py; backend/app/modules/identity/jobs.py; backend/app/modules/deeds/jobs.py; backend/app/modules/media/jobs.py; backend/app/modules/feed/jobs.py; backend/app/modules/feed/handlers.py; docker-compose.yml#worker" details="Media jobs run on the 'media' queue so photo processing can get its own worker later; in M3 the single worker listens to every queue.">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
