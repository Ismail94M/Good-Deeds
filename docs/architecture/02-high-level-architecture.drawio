        <object id="screens" label="&lt;b&gt;M2 screens&lt;/b&gt; (F2, F3, F6)&lt;br&gt;My QR: QR + ID + 6-digit code, countdown; Record a deed: hub, camera scan, ID + code, deed form, result; My deeds: detail, edit, withdraw; self-logs; profile counts; forgot password&lt;br&gt;&lt;i&gt;Not in M2: invite screens (D26), photos (D23)&lt;/i&gt;" status="implemented" milestone="M2" source="frontend/src/features/qr/MyQrPage.tsx; frontend/src/features/report/ReportHubPage.tsx; frontend/src/features/deeds/MyDeedsPage.tsx; frontend/src/features/selflog/SelfLogsPage.tsx; frontend/src/features/profile/DeedCounts.tsx; frontend/src/features/auth/ForgotPasswordPage.tsx; frontend/src/features/deeds/deedsApi.ts" details="Built from the approved Design canvases (docs/design/f2, f3, f6). Limits and copy values come from GET /api/deeds/options and the scan response, never hard-coded (D20)."><mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="740" width="340" height="120" as="geometry" /></mxCell></object>
