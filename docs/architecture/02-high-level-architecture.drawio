          </mxCell>
        </object>
        <object id="api" label="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;[Python 3.12, FastAPI, SQLAlchemy 2 async]&lt;br&gt;modules: identity, deeds&lt;br&gt;&lt;br&gt;/api/health&lt;br&gt;/api/auth/: config, signup, login,&lt;br&gt;oauth/{provider}, refresh, logout&lt;br&gt;/api/users/me (+ age-consent, phone/start,&lt;br&gt;phone/verify, qr, qr/rotate)&lt;br&gt;/api/users/{handle} (+ /deed-counts)&lt;br&gt;&lt;br&gt;&lt;i&gt;M2 deeds:&lt;/i&gt;&lt;br&gt;/api/scans, /api/deeds (+ options, {id},&lt;br&gt;PATCH, withdraw)&lt;br&gt;/api/invites/by-token/{token} (+ accept),&lt;br&gt;/api/invites/{id}/reissue&lt;br&gt;/api/me/deeds, /api/me/invites, /api/me/self-logs&lt;br&gt;&lt;br&gt;Postgres rate limits, limits from config rows,&lt;br&gt;outbox emit, audit log" status="implemented" milestone="M2" source="backend/app/main.py; backend/app/modules/registry.py; backend/app/modules/identity/router.py; backend/app/modules/deeds/router.py; backend/app/core/health.py; backend/app/core/ratelimit.py; backend/app/core/runtime_config.py">
