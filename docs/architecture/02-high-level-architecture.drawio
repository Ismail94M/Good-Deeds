        <object id="spa" label="&lt;b&gt;Web SPA&lt;/b&gt;&lt;br&gt;[React 19, TypeScript, Vite, Tailwind, TanStack Query]&lt;br&gt;/ (feed when signed in), /signup, /login, /forgot-password,&lt;br&gt;/onboarding, /profile, /me/qr, /me/deeds, /me/self-logs,&lt;br&gt;/me/saved, /me/connections, /deeds/:id, /report/*, /scan/:token,&lt;br&gt;/d/:id (public), /u/:handle, /admin/*, /terms, /privacy, guidelines" status="implemented" milestone="M1" source="frontend/src/app/routes.tsx; frontend/src/lib/api.ts; frontend/vite.config.ts" details="/scan/:token moves the QR token into memory and replaces the URL with /report/link (security R5-L2). Global header with 'Record a deed' (D25).">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
