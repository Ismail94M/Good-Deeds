        <object id="auth" label="&lt;b&gt;Auth mechanism&lt;/b&gt;&lt;br&gt;Access JWT (15 min) in memory, sent as Bearer&lt;br&gt;Refresh token: rotating httpOnly cookie gd_refresh,&lt;br&gt;path /api/auth, SameSite=Lax, stored hashed&lt;br&gt;30-day refresh, 90-day absolute session,&lt;br&gt;token_version revocation; X-Device-Id header" status="implemented" milestone="M1" source="frontend/src/lib/api.ts; backend/app/modules/identity/router.py#_set_refresh_cookie; backend/app/core/security.py; backend/app/core/config.py">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
            <mxGeometry x="340" y="520" width="340" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="api" label="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;[Python 3.12, FastAPI, SQLAlchemy 2 async]&lt;br&gt;modules: identity, deeds, media (M3), feed (M3),&lt;br&gt;scoring (M4), fraud (M5), notifications (M6A)&lt;br&gt;&lt;br&gt;/api/health, /api/auth/*, /api/users/*&lt;br&gt;/api/scans, /api/deeds, /api/me/deeds,&lt;br&gt;/api/me/self-logs, invites (switched off, D17)&lt;br&gt;&lt;br&gt;&lt;i&gt;M3 media:&lt;/i&gt; /api/media/options, uploads (+ complete),&lt;br&gt;deeds/{id}/photos, self-logs/{id}/photos,&lt;br&gt;photos/{id} (DELETE), photos/{id}/reports&lt;br&gt;&lt;br&gt;&lt;i&gt;M3 feed:&lt;/i&gt; /api/feed (+ options, deeds/{id}, likes,&lt;br&gt;saves, shares, comments, hide/show, notices),&lt;br&gt;/api/public/deeds/{id} (no login, no-store, noindex),&lt;br&gt;/api/users/{handle}/follow, /social; /api/me/saved,&lt;br&gt;/api/me/followers, /api/me/following&lt;br&gt;&lt;br&gt;&lt;i&gt;M3 review (moderator or admin):&lt;/i&gt;&lt;br&gt;/api/admin/photo-reports, /api/admin/photos/{id}/restore,&lt;br&gt;/api/admin/comment-reports, /api/admin/comments/{id}/restore&lt;br&gt;&lt;br&gt;&lt;i&gt;M6A:&lt;/i&gt; /api/notifications (+ unread-count, seen,&lt;br&gt;read-all, {id}/read|unread, preferences, mutes);&lt;br&gt;/api/media/me/avatar, /api/media/avatars/urls&lt;br&gt;(M4 scoring and M5 fraud routes not listed here)&lt;br&gt;&lt;br&gt;Postgres rate limits, limits from config rows,&lt;br&gt;outbox emit, audit log; token paths redacted" status="implemented" milestone="M3" source="backend/app/main.py; backend/app/modules/registry.py; backend/app/modules/identity/router.py; backend/app/modules/deeds/router.py; backend/app/modules/media/router.py; backend/app/modules/feed/router.py; backend/app/core/health.py; backend/app/core/ratelimit.py; backend/app/core/runtime_config.py; backend/app/core/log_redaction.py; backend/app/modules/scoring/router.py; backend/app/modules/fraud/router.py; backend/app/modules/notifications/router.py">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
            <mxGeometry x="840" y="270" width="300" height="650" as="geometry" />
          </mxCell>
        </object>
        <object id="db" label="&lt;b&gt;PostgreSQL 16 + PostGIS 3.4&lt;/b&gt;&lt;br&gt;core: outbox_events, processed_events,&lt;br&gt;audit_log, rate_limits, config_versions&lt;br&gt;identity: users (+ avatar_ref, M6A), consents, doer_codes,&lt;br&gt;oauth_accounts, phone_otps, refresh_tokens,&lt;br&gt;user_devices, phone_history&lt;br&gt;deeds: qr_scans, same_act_groups, deeds (+ area_id),&lt;br&gt;invites, verification_events, deed_revisions,&lt;br&gt;self_logs, areas (M3)&lt;br&gt;media (M3): photos (+ avatar purpose, M6A), photo_report_cases,&lt;br&gt;photo_reports, photo_decisions&lt;br&gt;feed (M3): feed_posts, feed_likes, feed_comments,&lt;br&gt;feed_saves, feed_shares, follows, feed_notices_seen,&lt;br&gt;feed_top_snapshots, feed_top_entries,&lt;br&gt;comment_report_cases, comment_reports, comment_decisions&lt;br&gt;scoring (M4, 11 tables), fraud (M5, 13 tables incl.&lt;br&gt;explanation_reminders 0033): not itemised here&lt;br&gt;notifications (M6A, 0030): notifications, notification_views,&lt;br&gt;_preferences, _mutes, _dedupe, _fanouts, _daily_counts&lt;br&gt;+ Procrastinate job schema (head 0034)" status="implemented" milestone="M3" source="backend/alembic/versions/2026_11_11_0000-0001_foundation.py; backend/alembic/versions/2026_11_11_1200-0002_identity.py; backend/alembic/versions/2026_11_11_1217-0003_identity_hardening.py; backend/alembic/versions/2026_11_13_0000-0004_runtime_config.py; backend/alembic/versions/2026_11_13_0100-0005_deeds.py; backend/alembic/versions/2026_11_15_0000-0006_identity_config.py; backend/alembic/versions/2026_11_16_0000-0007_deeds_v2.py; backend/alembic/versions/2026_11_17_0000-0008_deeds_v3.py; backend/alembic/versions/2026_11_17_0100-0009_deeds_v4.py; backend/alembic/versions/2026_11_17_0300-0011_identity_password_reset.py; backend/alembic/versions/2026_11_17_0400-0012_identity_reset_limits.py; backend/alembic/versions/2026_11_19_0000-0013_deeds_v5.py; backend/alembic/versions/2026_11_19_0100-0014_media.py; backend/alembic/versions/2026_11_19_0200-0015_feed.py; backend/alembic/versions/2026_11_21_0000-0016_feed_top_comments.py; backend/alembic/versions/2026_11_21_0100-0017_real_ward_areas.py; backend/alembic/versions/2026_11_21_0200-0018_deeds_v6.py; backend/alembic/versions/2026_11_22_0000-0019_deeds_v7_regions.py; backend/alembic/versions/2026_11_22_0100-0020_scoring.py; backend/alembic/versions/2026_11_22_0200-0021_outbox_handlers.py; backend/alembic/versions/2026_11_23_0000-0022_leaderboard_area_only.py; backend/alembic/versions/2026_11_23_0100-0023_featured_city.py; backend/alembic/versions/2026_11_23_0200-0024_stories.py; backend/alembic/versions/2026_11_24_0000-0025_city_leaderboard.py; backend/alembic/versions/2026_11_26_0000-0026_fraud.py; backend/alembic/versions/2026_11_26_0100-0027_scoring_overrides.py; backend/alembic/versions/2026_11_26_0200-0028_override_raise_requests.py; backend/alembic/versions/2026_11_26_0300-0029_fraud_sec5.py; backend/alembic/versions/2026_11_27_0000-0030_notifications.py; backend/alembic/versions/2026_11_27_0100-0031_media_avatars.py; backend/alembic/versions/2026_11_27_0200-0032_identity_avatar.py; backend/alembic/versions/2026_11_27_0300-0033_fraud_review_reminders.py; backend/alembic/versions/2026_11_28_0000-0034_notifications_sec6.py" details="M6A migrations: 0030 notifications tables + notifications v1 config; 0031 photos avatar purpose, avatar_crop, one live avatar per person, impersonation reason, media config avatar keys; 0032 users.avatar_ref + avatar_changed_at; 0033 explanation_reminders (append-only) + fraud explanation.reminder_days_before_due; 0034 notifications replies.max_recipients_per_comment and photos reject_reason cooldown. Migration 0010 does not exist.">
          <mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
            <mxGeometry x="840" y="950" width="285" height="420" as="geometry" />
          </mxCell>
        </object>
        <object id="worker" label="&lt;b&gt;Worker&lt;/b&gt; [Procrastinate] (one worker, all queues)&lt;br&gt;core.dispatch_outbox (every 5 s), core.handle_event&lt;br&gt;identity.purge_expired_records (03:17)&lt;br&gt;deeds.expire_invites (15 min), deeds.purge_unconsumed_scans (03:37)&lt;br&gt;&lt;i&gt;M3 media queue:&lt;/i&gt; media.process_queued (every 5 s; avatars too, M6A),&lt;br&gt;media.move_objects (1 min), media.purge_deleted (5 min),&lt;br&gt;media.sweep_late_puts (5 min), media.expire_uploads (30 min),&lt;br&gt;media.purge_detached (hourly), media.purge_removed (02:23),&lt;br&gt;media.sweep_staging (02:53)&lt;br&gt;&lt;i&gt;M3 feed:&lt;/i&gt; feed.refresh_top (every min, per period when due),&lt;br&gt;feed.erase_deleted_comments (03:47)&lt;br&gt;&lt;i&gt;M6A notifications queue:&lt;/i&gt; notifications.fanout_network (10 s),&lt;br&gt;notifications.purge (03:40 IST); fraud.remind_explanations (daily)&lt;br&gt;handlers: feed, identity (AvatarChanged), notifications;&lt;br&gt;M4 scoring and M5 fraud jobs not listed here" status="implemented" milestone="M3" source="backend/app/core/jobs.py; backend/app/modules/identity/jobs.py; backend/app/modules/deeds/jobs.py; backend/app/modules/media/jobs.py; backend/app/modules/feed/jobs.py; backend/app/modules/feed/handlers.py; docker-compose.yml#worker; backend/app/modules/notifications/jobs.py; backend/app/modules/notifications/handlers.py; backend/app/modules/fraud/jobs.py; backend/app/modules/identity/handlers.py" details="Media jobs run on the 'media' queue so photo processing can get its own worker later; in M3 the single worker listens to every queue.">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
