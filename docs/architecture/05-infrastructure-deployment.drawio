        <object id="web" label="&lt;b&gt;web&lt;/b&gt;&lt;br&gt;build ./frontend&lt;br&gt;npm run dev -- --host 0.0.0.0&lt;br&gt;port 5173:5173&lt;br&gt;bind ./frontend/src:/app/src&lt;br&gt;VITE_API_PROXY_TARGET=http://api:8000&lt;br&gt;VITE_USE_POLLING=true (M2)&lt;br&gt;allowedHosts .trycloudflare.com (M2)&lt;br&gt;&lt;i&gt;depends_on: api (started)&lt;/i&gt;" status="implemented" milestone="M2" source="docker-compose.yml#web; frontend/vite.config.ts" details="VITE_USE_POLLING makes Vite poll for file changes every 300 ms, because Docker on Windows doesn't forward file-change events into the container. allowedHosts lets a phone reach the dev server through a cloudflared quick tunnel.">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
