  <diagram id="feed-mod" name="Feed module (M3)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="1600" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="feed-mod-title" value="&lt;b&gt;03 Backend modules: the feed module (M3)&lt;/b&gt;&lt;br&gt;Synced to 2c7ba38 (branch m3-feed) + uncommitted 0017/0018, 2026-11-21" style="text;html=1;align=left;verticalAlign=top;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="50" as="geometry" /></mxCell>
        <mxCell id="feed-mod-legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=none;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="10" width="400" height="70" as="geometry" /></mxCell>
        <mxCell id="feed-mod-lg-implemented" value="implemented" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1188" y="38" width="90" height="32" as="geometry" /></mxCell>
        <mxCell id="feed-mod-lg-partial" value="partial" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1286" y="38" width="90" height="32" as="geometry" /></mxCell>
        <mxCell id="feed-mod-lg-planned" value="planned (Mx)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="1384" y="38" width="90" height="32" as="geometry" /></mxCell>
        <mxCell id="feed-mod-lg-proposed" value="proposed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;dashPattern=1 4;" vertex="1" parent="1"><mxGeometry x="1482" y="38" width="90" height="32" as="geometry" /></mxCell>
        <mxCell id="feed-mod-box" value="modules/feed (M3, D29): feed projection, visibility, likes, comments, saves, shares, follows, Top, comment reports" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1140" height="680" as="geometry" /></mxCell>
        <object id="feed-mod-router" label="&lt;b&gt;router.py&lt;/b&gt; (/api)&lt;br&gt;GET /feed (nearby | following | top + period), /feed/options&lt;br&gt;GET /feed/deeds/{id}&lt;br&gt;GET /public/deeds/{id} (no login; no-store, noindex)&lt;br&gt;GET /users/{handle}/social, /feed/users/{handle}/deeds&lt;br&gt;PUT/DELETE /feed/deeds/{id}/like, /save&lt;br&gt;POST /feed/deeds/{id}/shares, /hide, /show&lt;br&gt;GET/POST /feed/deeds/{id}/comments&lt;br&gt;DELETE /feed/comments/{id}&lt;br&gt;PUT/DELETE /users/{handle}/follow&lt;br&gt;GET /me/saved, /me/followers, /me/following&lt;br&gt;DELETE /me/followers/{handle}&lt;br&gt;GET /feed/me/notices, /feed/me/comment-notices (+ seen)&lt;br&gt;POST /feed/comments/{id}/reports&lt;br&gt;&lt;i&gt;ReviewerUser:&lt;/i&gt; GET /admin/comment-reports (+ /{id}),&lt;br&gt;POST .../decision, POST /admin/comments/{id}/restore" status="implemented" milestone="M3" source="backend/app/modules/feed/router.py; backend/app/modules/registry.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="330" height="300" as="geometry" /></mxCell></object>
        <object id="feed-mod-handlers" label="&lt;b&gt;handlers.py&lt;/b&gt; @subscribe DeedVerified, DeedWithdrawn, DeedRejected → _projection.sync_post(deed_id): idempotent, reads the deed's current status (D37)" status="implemented" milestone="M3" source="backend/app/modules/feed/handlers.py; backend/app/modules/feed/_projection.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="330" height="80" as="geometry" /></mxCell></object>
        <object id="feed-mod-jobs" label="&lt;b&gt;jobs.py&lt;/b&gt; feed.refresh_top (every minute; a period refreshes when due: 10 / 30 / 60 min) · feed.erase_deleted_comments (03:47)" status="implemented" milestone="M3" source="backend/app/modules/feed/jobs.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="555" width="330" height="70" as="geometry" /></mxCell></object>
        <object id="feed-mod-service" label="&lt;b&gt;service.py&lt;/b&gt; (public surface)&lt;br&gt;is_public, can_view, visibility (VisibilityView)&lt;br&gt;read by the media router; never by scoring (D30, D36)" status="implemented" milestone="M3" source="backend/app/modules/feed/service.py; backend/tests/test_architecture.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="330" height="95" as="geometry" /></mxCell></object>
        <mxCell id="feed-mod-priv" value="private files (_name.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="135" width="745" height="455" as="geometry" /></mxCell>
        <object id="feed-mod-reads" label="&lt;b&gt;_reads.py + _compose.py&lt;/b&gt; Nearby, Following (doer or reporter followed, Q25), profile, saved, deed and public pages; drops deeds no longer verified (D37); content live from deeds.get_deeds (D38); photos from media.public_photos" status="implemented" milestone="M3" source="backend/app/modules/feed/_reads.py; backend/app/modules/feed/_compose.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="165" width="350" height="90" as="geometry" /></mxCell></object>
        <object id="feed-mod-top" label="&lt;b&gt;_top.py&lt;/b&gt; Top snapshots per period, rolling 7 / 30 / 365 days (Q26): likes + 3 × comments; self-likes and doer / reporter comments weigh 0 (Q43, L1)" status="implemented" milestone="M3" source="backend/app/modules/feed/_top.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="265" width="350" height="70" as="geometry" /></mxCell></object>
        <object id="feed-mod-writes" label="&lt;b&gt;_writes.py + _follows.py&lt;/b&gt; like, save, share, hide / show (each person's own hide, Q24; audited); open follows, quiet remove-follower" status="implemented" milestone="M3" source="backend/app/modules/feed/_writes.py; backend/app/modules/feed/_follows.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="345" width="350" height="65" as="geometry" /></mxCell></object>
        <object id="feed-mod-comments" label="&lt;b&gt;_comments.py + _kindness.py + _text.py&lt;/b&gt; 300 chars, rate limits, English kind-words pack (Q35), links and phone numbers refused (Q37); author delete erases at once; doer / reporter / moderation removals keep the text 30 days (Q38, L3)" status="implemented" milestone="M3" source="backend/app/modules/feed/_comments.py; backend/app/modules/feed/_kindness.py; backend/app/modules/feed/_text.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="420" width="350" height="85" as="geometry" /></mxCell></object>
        <object id="feed-mod-moder" label="&lt;b&gt;_reports.py + _moderation.py&lt;/b&gt; comment reports (onboarded), one case per comment; keep / remove / restore with a note; comment_decisions + audit (D45)" status="implemented" milestone="M3" source="backend/app/modules/feed/_reports.py; backend/app/modules/feed/_moderation.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="515" width="350" height="65" as="geometry" /></mxCell></object>
        <object id="feed-mod-proj" label="&lt;b&gt;_projection.py&lt;/b&gt; sync_post: upsert feed_posts; a terminal state is never overwritten by published" status="implemented" milestone="M3" source="backend/app/modules/feed/_projection.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="165" width="350" height="55" as="geometry" /></mxCell></object>
        <object id="feed-mod-access" label="&lt;b&gt;_access.py, _notices.py, _photos.py&lt;/b&gt; who may see a deed (role_of); one-time feed notice (Q41) and comment-removed notices; photo shapes" status="implemented" milestone="M3" source="backend/app/modules/feed/_access.py; backend/app/modules/feed/_notices.py; backend/app/modules/feed/_photos.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="230" width="350" height="70" as="geometry" /></mxCell></object>
        <object id="feed-mod-limits" label="&lt;b&gt;_limits.py + _shared_limits.py&lt;/b&gt; FeedLimits (namespace feed, v1, 0015), no defaults: comment, rate, Top and retention values, language packs. SharedReportLimits reads the report keys of the media namespace (read only)" status="implemented" milestone="M3" source="backend/app/modules/feed/_limits.py; backend/app/modules/feed/_shared_limits.py; backend/alembic/versions/2026_11_19_0200-0015_feed.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="310" width="350" height="95" as="geometry" /></mxCell></object>
        <object id="feed-mod-cursor" label="&lt;b&gt;_cursor.py&lt;/b&gt; opaque keyset cursors (D40)" status="implemented" milestone="M3" source="backend/app/modules/feed/_cursor.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="415" width="350" height="40" as="geometry" /></mxCell></object>
        <object id="feed-mod-tables" label="&lt;b&gt;models.py tables&lt;/b&gt; (0015, 0016)&lt;br&gt;feed_posts (state, hides, counters, top_like_count, top_comment_count, generated listed), feed_likes, feed_comments (+ author_deleted_at), feed_saves, feed_shares, follows, feed_notices_seen, feed_top_snapshots, feed_top_entries, comment_report_cases, comment_reports, comment_decisions (append-only)" status="implemented" milestone="M3" source="backend/app/modules/feed/models.py; backend/alembic/versions/2026_11_19_0200-0015_feed.py; backend/alembic/versions/2026_11_21_0000-0016_feed_top_comments.py"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="610" width="360" height="150" as="geometry" /></mxCell></object>
        <object id="feed-mod-events" label="&lt;b&gt;events.py&lt;/b&gt; emits DeedLiked, CommentPosted, UserFollowed, CommentModerationDecided (IDs only; no subscribers in M3; M6 notifications). Unlikes, unfollows, hides and saves emit nothing" status="implemented" milestone="M3" source="backend/app/modules/feed/events.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="610" width="365" height="110" as="geometry" /></mxCell></object>
        <object id="feed-mod-deeds" label="&lt;b&gt;deeds service.py&lt;/b&gt; get_deed, get_deeds, deeds_for_doer, area_name, category_labels; DeedVerified / Withdrawn / Rejected" status="implemented" milestone="M3" source="backend/app/modules/deeds/service.py; backend/app/modules/feed/handlers.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="100" width="340" height="80" as="geometry" /></mxCell></object>
        <object id="feed-mod-media" label="&lt;b&gt;media service.py&lt;/b&gt; public_photos, sign_variants" status="implemented" milestone="M3" source="backend/app/modules/media/service.py; backend/app/modules/feed/_reads.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="195" width="340" height="50" as="geometry" /></mxCell></object>
        <object id="feed-mod-identity" label="&lt;b&gt;identity service.py&lt;/b&gt; CurrentUser (read), OnboardedUser (social actions, D44), ReviewerUser, public_summaries, get_user_by_handle" status="implemented" milestone="M3" source="backend/app/modules/identity/service.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="260" width="340" height="75" as="geometry" /></mxCell></object>
        <object id="feed-mod-core" label="&lt;b&gt;core&lt;/b&gt; events (outbox, run_handler), ratelimit, audit, runtime_config, db" status="implemented" milestone="M0" source="backend/app/core/events.py; backend/app/core/ratelimit.py; backend/app/core/audit.py; backend/app/core/runtime_config.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="350" width="340" height="55" as="geometry" /></mxCell></object>
        <object id="feed-mod-outbox" label="&lt;b&gt;Outbox&lt;/b&gt; deeds events in; feed events out (same transaction)" status="implemented" milestone="M0" source="backend/app/core/events.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="640" width="340" height="50" as="geometry" /></mxCell></object>
        <mxCell id="feed-mod-rule" value="&lt;b&gt;Rules&lt;/b&gt; (M3-DESIGN §0). Visibility lives in feed_posts, separate from deed status, counts and prize fields; nothing in scoring may import feed (D36, test_architecture). Only verified deeds appear (Q23); one post per verified report (Q27); area name only, never coordinates (D39). Reading the feed needs a signed-in user; liking, commenting, saving, following and comment reports need onboarding (D44). Feed imports media.service, deeds.service and identity.service; media never imports feed outside its router (D30)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1140" height="80" as="geometry" /></mxCell>
        <mxCell id="feed-mod-e1" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="feed-mod-router" target="feed-mod-priv"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
        <mxCell id="feed-mod-e2" value="sync_post" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="feed-mod-handlers" target="feed-mod-priv"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
        <mxCell id="feed-mod-e3" value="batches" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.92;entryDx=0;entryDy=0;" edge="1" parent="1" source="feed-mod-jobs" target="feed-mod-priv"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
        <mxCell id="feed-mod-e4" value="service.py calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=1;exitY=0.07;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="feed-mod-priv" target="feed-mod-deeds"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
        <mxCell id="feed-mod-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="feed-mod-priv" target="feed-mod-media"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
        <mxCell id="feed-mod-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=1;exitY=0.37;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="feed-mod-priv" target="feed-mod-identity"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
        <mxCell id="feed-mod-e7" value="app.core" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="feed-mod-priv" target="feed-mod-core"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
        <mxCell id="feed-mod-e8" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="feed-mod-priv" target="feed-mod-tables"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
