          <mxCell id="deeds-mod-e4" value="app.core" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="deeds-mod-priv" target="deeds-mod-rc"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell>
