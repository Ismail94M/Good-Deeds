        <mxCell id="notif-mod-e4" value="service.py calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=1;exitY=0.03;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="notif-mod-priv" target="notif-mod-deeds"><mxGeometry relative="1" as="geometry" /></mxCell>
