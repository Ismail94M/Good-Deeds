        <object id="media-mod-tables" label="&lt;b&gt;models.py tables&lt;/b&gt; (migration 0014)&lt;br&gt;photos (status, takedown, object_move, variant_keys, blur regions, hash)&lt;br&gt;photo_report_cases, photo_reports,&lt;br&gt;photo_decisions (append-only)&lt;br&gt;&lt;i&gt;M6A:&lt;/i&gt; photos.purpose avatar, avatar_crop, uq_photos_live_avatar, reason impersonation (0031); reject_reason cooldown (0034)" status="implemented" milestone="M3" source="backend/app/modules/media/models.py; backend/alembic/versions/2026_11_19_0100-0014_media.py; backend/alembic/versions/2026_11_27_0100-0031_media_avatars.py; backend/alembic/versions/2026_11_28_0000-0034_notifications_sec6.py"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="600" width="360" height="130" as="geometry" /></mxCell></object>
        <object id="media-mod-events" label="&lt;b&gt;events.py&lt;/b&gt;&lt;br&gt;PhotoRemovedByDoer, PhotoModerationDecided (→ notifications)&lt;br&gt;DeedPhotoReady (→ scoring)&lt;br&gt;&lt;i&gt;M6A:&lt;/i&gt; AvatarChanged (→ identity), AvatarModerationDecided (→ notifications)&lt;br&gt;IDs and enums only" status="implemented" milestone="M3" source="backend/app/modules/media/events.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="600" width="365" height="130" as="geometry" /></mxCell></object>
