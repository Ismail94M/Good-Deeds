        <object id="notif-mod-feed" label="&lt;b&gt;feed service.py&lt;/b&gt; (named only) DeedLiked, CommentPosted, UserFollowed, CommentModerationDecided; reads visible_deed_ids, follower_ids_page, earlier_commenter_ids" status="implemented" milestone="M6A" source="backend/app/modules/feed/service.py; backend/tests/test_architecture.py#NOTIFICATIONS_NAMED"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="230" width="340" height="75" as="geometry" /></mxCell></object>
