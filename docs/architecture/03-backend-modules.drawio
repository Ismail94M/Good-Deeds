<mxfile host="drawio" agent="architecture-diagram">
  <diagram id="core-identity" name="Core + identity (implemented)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
          <mxCell id="0" />
          <mxCell id="1" parent="0" />
          <mxCell id="core-identity-title" value="&lt;b&gt;03 Backend modules: core layer + identity (M0/M1, M2 and M3 changes)&lt;/b&gt;&lt;br&gt;Synced to 371606c (branch m6-notifications), 2026-11-28" style="text;html=1;align=left;verticalAlign=top;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="50" as="geometry" /></mxCell>
          <mxCell id="core-identity-legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=none;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="10" width="400" height="70" as="geometry" /></mxCell>
          <mxCell id="core-identity-lg-implemented" value="implemented" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1188" y="38" width="90" height="32" as="geometry" /></mxCell>
          <mxCell id="core-identity-lg-partial" value="partial" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1286" y="38" width="90" height="32" as="geometry" /></mxCell>
          <mxCell id="core-identity-lg-planned" value="planned (Mx)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="1384" y="38" width="90" height="32" as="geometry" /></mxCell>
          <mxCell id="core-identity-lg-proposed" value="proposed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;dashPattern=1 4;" vertex="1" parent="1"><mxGeometry x="1482" y="38" width="90" height="32" as="geometry" /></mxCell>
          <object id="core-identity-main" label="app.main.create_app()&lt;br&gt;FastAPI, CORS, error handlers,&lt;br&gt;access-log token redaction (M2),&lt;br&gt;mounts routers under /api" status="implemented" milestone="M0" source="backend/app/main.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="260" height="75" as="geometry" /></mxCell></object>
          <object id="core-identity-registry" label="modules/registry.py&lt;br&gt;MODULES = [identity, deeds, media, feed,&lt;br&gt;scoring, fraud, notifications (M6A)]&lt;br&gt;imports models / handlers / jobs, mounts routers" status="implemented" milestone="M3" source="backend/app/modules/registry.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="330" height="60" as="geometry" /></mxCell></object>
          <mxCell id="core-identity-e-main-reg" value="load_modules()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="core-identity-main" target="core-identity-registry"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
          <mxCell id="core-identity-idbox" value="modules/identity (M1)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fillColor=none;strokeColor=#82b366;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1140" height="480" as="geometry" /></mxCell>
          <object id="core-identity-router" label="&lt;b&gt;router.py&lt;/b&gt; (/api)&lt;br&gt;/auth/config, /auth/signup, /auth/login,&lt;br&gt;/auth/oauth/{provider}, /auth/refresh, /auth/logout&lt;br&gt;/auth/password/forgot, /auth/password/reset (M2)&lt;br&gt;/users/me (GET, PATCH), /users/me/age-consent&lt;br&gt;/users/me/phone/start, /users/me/phone/verify&lt;br&gt;/users/me/qr (+ manual_code, window_seconds),&lt;br&gt;/users/me/qr/rotate, /users/{handle}" status="implemented" milestone="M2" source="backend/app/modules/identity/router.py" details="Forgot answers the same way whether or not an account exists. The reset SMS is sent by a background task that first charges sms:reset_global and quietly skips the SMS when that budget is spent."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="330" height="160" as="geometry" /></mxCell></object>
          <object id="core-identity-service" label="&lt;b&gt;service.py&lt;/b&gt; (public surface)&lt;br&gt;CurrentUser, OnboardedUser, require_role, ReviewerUser (M3),&lt;br&gt;DeviceId, resolve_qr_token, resolve_manual_code → ResolvedDoer,&lt;br&gt;phone_hashes, device_hash(es), public_summaries, is_active,&lt;br&gt;onboarding_status, get_user_by_handle, set_role (M3)&lt;br&gt;+ backs router: login_with_oauth, issue_session,&lt;br&gt;request_password_reset, reset_password, ..." status="implemented" milestone="M3" source="backend/app/modules/identity/service.py" details="The resolvers are called by deeds/_scans.py since M2; resolve_short_id was removed so the static ID alone never resolves. is_active is used by invite accept (suspended reporter → 404). reset_password revokes every session (refresh tokens + token_version) and writes audit_log user.password_reset. Refresh: replaying a token ended by revoke-all or from an older token_version gets 401 session_expired without revoking again; reusing a rotated token still revokes all. start_phone_verification's hourly caps count phone_verify codes only."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="220" width="330" height="160" as="geometry" /></mxCell></object>
          <object id="core-identity-oauth" label="&lt;b&gt;_oauth.py&lt;/b&gt;&lt;br&gt;GoogleVerifier: JWKS, RS256, aud/iss, 30 s leeway" status="implemented" milestone="M1" source="backend/app/modules/identity/_oauth.py; docker-compose.yml" details="Button shown only when GD_GOOGLE_CLIENT_ID is set (root .env via docker-compose)"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="215" width="300" height="55" as="geometry" /></mxCell></object>
          <object id="core-identity-qr" label="&lt;b&gt;_qr.py&lt;/b&gt; (pure)&lt;br&gt;short ID GD-xxxxxxx; token short_id.window.sig;&lt;br&gt;6-digit manual_code; QrConfig (namespace qr: 30 s, 1 grace)" status="implemented" milestone="M2" source="backend/app/modules/identity/_qr.py; backend/app/core/runtime_config.py; backend/alembic/versions/2026_11_13_0000-0004_runtime_config.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="285" width="300" height="65" as="geometry" /></mxCell></object>
          <object id="core-identity-fb" label="FacebookVerifier (debug_token + appsecret_proof)" status="partial" milestone="M1" source="backend/app/modules/identity/_oauth.py; backend/app/core/config.py; docker-compose.yml" details="Code exists; GD_FACEBOOK_APP_ID/SECRET default empty and are not passed by docker-compose, so hidden"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="365" width="300" height="45" as="geometry" /></mxCell></object>
          <object id="core-identity-tables" label="&lt;b&gt;models.py tables&lt;/b&gt;&lt;br&gt;users (+ avatar_ref, avatar_changed_at: M6A, 0032),&lt;br&gt;oauth_accounts, refresh_tokens, phone_otps (+ purpose, M2),&lt;br&gt;user_devices, consents, doer_codes,&lt;br&gt;phone_history (append-only trigger)" status="implemented" milestone="M2" source="backend/app/modules/identity/models.py; backend/alembic/versions/2026_11_11_1200-0002_identity.py; backend/alembic/versions/2026_11_11_1217-0003_identity_hardening.py; backend/alembic/versions/2026_11_17_0300-0011_identity_password_reset.py; backend/alembic/versions/2026_11_27_0200-0032_identity_avatar.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="425" width="300" height="90" as="geometry" /></mxCell></object>
          <object id="core-identity-events" label="&lt;b&gt;events.py&lt;/b&gt;&lt;br&gt;UserRegistered, PhoneVerified, PasswordChanged (→ notifications, M6A), UserAnonymised&lt;br&gt;&lt;b&gt;handlers.py&lt;/b&gt; (M6A): AvatarChanged → users.avatar_ref" status="implemented" milestone="M1" source="backend/app/modules/identity/events.py; backend/app/modules/identity/handlers.py" details="PasswordChanged is heard by notifications (in-app row; email in M6B). identity/handlers.py may import only AvatarChanged from media.service (test_architecture IDENTITY_FROM_MEDIA)."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="330" height="80" as="geometry" /></mxCell></object>
          <object id="core-identity-jobs" label="&lt;b&gt;jobs.py&lt;/b&gt;&lt;br&gt;identity.purge_expired_records&lt;br&gt;periodic 03:17 daily: OTPs, dead sessions, rate_limits" status="implemented" milestone="M1" source="backend/app/modules/identity/jobs.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="330" height="65" as="geometry" /></mxCell></object>
          <object id="core-identity-limits" label="&lt;b&gt;_limits.py&lt;/b&gt;&lt;br&gt;IdentityLimits (namespace identity, v3):&lt;br&gt;OTP rules and auth rate limits (0006); forgot / reset&lt;br&gt;limits per IP and phone, hourly and daily, and the&lt;br&gt;reset SMS budget sms:reset_global (0011, 0012)" status="implemented" milestone="M2" source="backend/app/modules/identity/_limits.py; backend/alembic/versions/2026_11_15_0000-0006_identity_config.py; backend/alembic/versions/2026_11_17_0300-0011_identity_password_reset.py; backend/alembic/versions/2026_11_17_0400-0012_identity_reset_limits.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="525" width="300" height="110" as="geometry" /></mxCell></object>
          <object id="core-identity-rule" label="&lt;b&gt;Module boundary rule&lt;/b&gt; (CLAUDE.md)&lt;br&gt;A module imports only app.core and another module's service.py; cross-module side effects only via events.&lt;br&gt;Enforced by tests/test_architecture.py: absolute imports only (relative imports not checked); core may import only modules.registry; every module dir registered. The 'events, not direct calls' half is not machine-checked." status="implemented" milestone="M0" source="CLAUDE.md; backend/tests/test_architecture.py"><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="525" width="400" height="115" as="geometry" /></mxCell></object>
          <mxCell id="core-identity-e-r-s" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="core-identity-router" target="core-identity-service"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
          <mxCell id="core-identity-e-s-o" value="verify()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.17;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="core-identity-service" target="core-identity-oauth"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
          <mxCell id="core-identity-e-s-q" value="tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="core-identity-service" target="core-identity-qr"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
          <mxCell id="core-identity-e-s-t" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.92;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="core-identity-service" target="core-identity-tables"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="815" y="340" /><mxPoint x="815" y="470" /></Array></mxGeometry></mxCell>
          <mxCell id="core-identity-e-s-ev" value="emit()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="core-identity-service" target="core-identity-events"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="473" y="390" /><mxPoint x="225" y="390" /></Array></mxGeometry></mxCell>
          <mxCell id="core-identity-e-j-s" value="purge_expired_records()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="core-identity-jobs" target="core-identity-service"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
          <mxCell id="core-identity-corebox" value="app/core (M0 + M1 hardening + M2 runtime_config + M3 storage)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fillColor=none;strokeColor=#82b366;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1520" height="420" as="geometry" /></mxCell>
          <object id="core-identity-outbox" label="&lt;b&gt;events&lt;/b&gt;&lt;br&gt;emit() → outbox_events;&lt;br&gt;run_handler → processed_events" status="implemented" milestone="M0" source="backend/app/core/events.py; backend/alembic/versions/2026_11_11_0000-0001_foundation.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="230" height="100" as="geometry" /></mxCell></object>
          <object id="core-identity-jobsc" label="&lt;b&gt;jobs&lt;/b&gt; (Procrastinate)&lt;br&gt;core.dispatch_outbox every 5 s&lt;br&gt;core.handle_event (8 retries)" status="implemented" milestone="M0" source="backend/app/core/jobs.py; backend/alembic/versions/2026_11_11_0000-0001_foundation.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="310" y="730" width="230" height="100" as="geometry" /></mxCell></object>
          <object id="core-identity-config" label="&lt;b&gt;config&lt;/b&gt;&lt;br&gt;GD_* deployment settings only&lt;br&gt;(secrets, URLs, providers); refuses&lt;br&gt;unsafe prod values" status="implemented" milestone="M0" source="backend/app/core/config.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="730" width="230" height="100" as="geometry" /></mxCell></object>
          <object id="core-identity-rc" label="&lt;b&gt;runtime_config&lt;/b&gt; (M2)&lt;br&gt;config_versions (append-only);&lt;br&gt;RuntimeConfig, load(), publish() + audit" status="implemented" milestone="M2" source="backend/app/core/runtime_config.py; backend/alembic/versions/2026_11_13_0000-0004_runtime_config.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="730" width="230" height="100" as="geometry" /></mxCell></object>
          <object id="core-identity-db" label="&lt;b&gt;db&lt;/b&gt;&lt;br&gt;async SQLAlchemy + psycopg 3,&lt;br&gt;get_session,&lt;br&gt;advisory_xact_lock (M2);&lt;br&gt;stays READ COMMITTED" status="implemented" milestone="M0" source="backend/app/core/db.py" details="READ COMMITTED is kept on purpose: the monthly-limit counts taken after the reporter_month lock must see rows committed by the previous lock holder."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1060" y="730" width="230" height="100" as="geometry" /></mxCell></object>
          <object id="core-identity-audit" label="&lt;b&gt;audit&lt;/b&gt;&lt;br&gt;audit_log, forbid_modification()&lt;br&gt;trigger; record_audit" status="implemented" milestone="M0" source="backend/app/core/audit.py; backend/alembic/versions/2026_11_11_0000-0001_foundation.py" details="Written since M2 by runtime_config.publish, by deeds (prize-rank grants and revokes, promotions) and by identity's password reset (user.password_reset). QR reset, phone verification and revoke-all sessions are still not audited."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1310" y="730" width="230" height="100" as="geometry" /></mxCell></object>
          <object id="core-identity-security" label="&lt;b&gt;security&lt;/b&gt;&lt;br&gt;argon2 (thread), JWT, keyed_hash" status="implemented" milestone="M0" source="backend/app/core/security.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="230" height="100" as="geometry" /></mxCell></object>
          <object id="core-identity-ratelimit" label="&lt;b&gt;ratelimit&lt;/b&gt;&lt;br&gt;rate_limits fixed windows, Limiter;&lt;br&gt;specs come from config rows" status="implemented" milestone="M1" source="backend/app/core/ratelimit.py; backend/alembic/versions/2026_11_11_1217-0003_identity_hardening.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="310" y="860" width="230" height="100" as="geometry" /></mxCell></object>
          <object id="core-identity-errors" label="&lt;b&gt;errors&lt;/b&gt;&lt;br&gt;AppError → {detail, code};&lt;br&gt;Gone (410) added in M2;&lt;br&gt;AppError.extra adds body fields (D27)" status="implemented" milestone="M0" source="backend/app/core/errors.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="860" width="230" height="100" as="geometry" /></mxCell></object>
          <object id="core-identity-sms" label="&lt;b&gt;sms&lt;/b&gt;&lt;br&gt;SmsProvider; ConsoleSmsProvider only&lt;br&gt;(phone OTP and reset codes)" status="partial" milestone="M1" source="backend/app/core/sms.py" details="Dev-only console provider; real MSG91/Twilio deferred to pre-launch (ROADMAP)"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="810" y="860" width="230" height="100" as="geometry" /></mxCell></object>
          <object id="core-identity-health" label="&lt;b&gt;health&lt;/b&gt;&lt;br&gt;GET /api/health (DB + PostGIS)" status="implemented" milestone="M0" source="backend/app/core/health.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1060" y="860" width="230" height="100" as="geometry" /></mxCell></object>
<object id="core-identity-logredact" label="&lt;b&gt;log_redaction&lt;/b&gt; (M2)&lt;br&gt;uvicorn.access filter: /scan/{token} and&lt;br&gt;/api/invites/by-token/{token} → &amp;lt;redacted&amp;gt;" status="implemented" milestone="M2" source="backend/app/core/log_redaction.py; backend/app/main.py" details="Security review L1. Installed by create_app(), after uvicorn has configured its loggers, so it also applies under --reload."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1310" y="860" width="230" height="100" as="geometry" /></mxCell></object>
          <mxCell id="core-identity-e-ev-out" value="emit() in same txn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;exitDx=0;exitDy=0;entryDx=0;entryDy=0;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="core-identity-events" target="core-identity-outbox"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="452" /><mxPoint x="405" y="705" /><mxPoint x="175" y="705" /></Array></mxGeometry></mxCell>
          <mxCell id="core-identity-e-out-jobs" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="core-identity-outbox" target="core-identity-jobsc"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
          <mxCell id="core-identity-e-id-core" value="imports app.core only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.93;exitY=1;exitDx=0;exitDy=0;entryX=0.6974;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="core-identity-idbox" target="core-identity-corebox"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
      <object id="core-identity-cli" label="&lt;b&gt;cli.py&lt;/b&gt; (M3, D43): the only way to change a role&lt;br&gt;python -m app.modules.identity.cli set-role HANDLE&lt;br&gt;member|moderator|admin --reason ... --operator ...&lt;br&gt;audit_log role.changed (reason, operator);&lt;br&gt;bumps token_version (old tokens stop at once)" status="implemented" milestone="M3" source="backend/app/modules/identity/cli.py; backend/app/modules/identity/service.py" details="No HTTP endpoint changes roles in M3. Moderators and admins both review photo and comment reports (Q34)."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="525" width="330" height="115" as="geometry" /></mxCell></object>
        <object id="core-identity-storage" label="&lt;b&gt;storage&lt;/b&gt; (M3, D35) provider-neutral, S3-compatible API only&lt;br&gt;ObjectStorage protocol: presign_put (signs type + length), presign_get (stable signing time), head, get_range, get_bytes, put_bytes, copy, delete, list_older_than; move()&lt;br&gt;S3Storage (boto3, SigV4; GD_STORAGE_* settings, dev keys refused outside development); MemoryStorage for tests (get_storage override)" status="implemented" milestone="M3" source="backend/app/core/storage.py; backend/app/core/config.py" details="Production: Google Cloud Storage XML API (asia-south1, HMAC keys). Development: SeaweedFS in docker-compose. Integration tests against a real store run only with GD_TEST_STORAGE_URL."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="730" height="100" as="geometry" /></mxCell></object>
        <object id="core-identity-dbm3" label="&lt;b&gt;M3 core changes&lt;/b&gt;&lt;br&gt;db: engine with hide_parameters (SQL errors and logs never carry bound values, SEC L8)&lt;br&gt;events: feed subscribes to deeds events (first real subscribers); handlers run idempotently through processed_events" status="implemented" milestone="M3" source="backend/app/core/db.py; backend/app/core/events.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="990" width="730" height="100" as="geometry" /></mxCell></object>
        </root>
    </mxGraphModel>
  </diagram>
