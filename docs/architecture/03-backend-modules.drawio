        <object id="media-mod-limits" label="&lt;b&gt;_limits.py&lt;/b&gt; MediaLimits (namespace media, v1, 0014), no defaults: photos_enabled (from deeds, D41), photos per owner, add window, upload and URL TTLs, retention days, report and decision limits" status="implemented" milestone="M3" source="backend/app/modules/media/_limits.py; backend/alembic/versions/2026_11_19_0100-0014_media.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="365" width="350" height="85" as="geometry" /></mxCell></object>
