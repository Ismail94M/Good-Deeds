          <mxCell id="core-identity-idbox" value="modules/identity (M1)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fillColor=none;strokeColor=#82b366;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1140" height="470" as="geometry"/></mxCell>
          <object id="core-identity-router" label="&lt;b&gt;router.py&lt;/b&gt; (/api)&lt;br&gt;/auth/config, /auth/signup, /auth/login,&lt;br&gt;/auth/oauth/{provider}, /auth/refresh, /auth/logout&lt;br&gt;/users/me (GET, PATCH), /users/me/age-consent&lt;br&gt;/users/me/phone/start, /users/me/phone/verify&lt;br&gt;/users/me/qr, /users/me/qr/rotate, /users/{handle}" status="implemented" milestone="M1" source="backend/app/modules/identity/router.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="330" height="130" as="geometry"/></mxCell></object>
          <object id="core-identity-service" label="&lt;b&gt;service.py&lt;/b&gt; (public surface)&lt;br&gt;CurrentUser, OnboardedUser, require_role,&lt;br&gt;DeviceId, device_hashes, get_user,&lt;br&gt;get_user_by_handle, public_profile,&lt;br&gt;resolve_qr_token, resolve_short_id&lt;br&gt;+ backs router: login_with_oauth, issue_session, ..." status="implemented" milestone="M1" source="backend/app/modules/identity/service.py" details="resolve_qr_token / resolve_short_id have no caller outside tests yet; docstring says they are for Verification in M2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="220" width="330" height="130" as="geometry"/></mxCell></object>
          <object id="core-identity-oauth" label="&lt;b&gt;_oauth.py&lt;/b&gt;&lt;br&gt;GoogleVerifier: JWKS, RS256, aud/iss, 30 s leeway" status="implemented" milestone="M1" source="backend/app/modules/identity/_oauth.py; docker-compose.yml" details="Button shown only when GD_GOOGLE_CLIENT_ID is set (root .env via docker-compose)"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="215" width="300" height="55" as="geometry"/></mxCell></object>
          <object id="core-identity-qr" label="&lt;b&gt;_qr.py&lt;/b&gt;&lt;br&gt;short ID (Crockford, GD-xxxxxxx); token&lt;br&gt;short_id.window.sig, 30 s window, 2 grace windows" status="implemented" milestone="M1" source="backend/app/modules/identity/_qr.py; backend/app/core/config.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="285" width="300" height="65" as="geometry"/></mxCell></object>
          <object id="core-identity-fb" label="FacebookVerifier (debug_token + appsecret_proof)" status="partial" milestone="M1" source="backend/app/modules/identity/_oauth.py; backend/app/core/config.py; docker-compose.yml" details="Code exists; GD_FACEBOOK_APP_ID/SECRET default empty and are not passed by docker-compose, so hidden"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="365" width="300" height="45" as="geometry"/></mxCell></object>
          <object id="core-identity-tables" label="&lt;b&gt;models.py tables&lt;/b&gt;&lt;br&gt;users, oauth_accounts, refresh_tokens, phone_otps,&lt;br&gt;user_devices, consents, doer_codes,&lt;br&gt;phone_history (append-only trigger)" status="implemented" milestone="M1" source="backend/app/modules/identity/models.py; backend/alembic/versions/2026_11_11_1200-0002_identity.py; backend/alembic/versions/2026_11_11_1217-0003_identity_hardening.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="430" width="300" height="80" as="geometry"/></mxCell></object>
          <object id="core-identity-events" label="&lt;b&gt;events.py&lt;/b&gt;&lt;br&gt;UserRegistered (identity.user_registered)&lt;br&gt;PhoneVerified (identity.phone_verified)" status="implemented" milestone="M1" source="backend/app/modules/identity/events.py" details="Emitted, but no module has a handlers.py subscribing to them yet"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="330" height="65" as="geometry"/></mxCell></object>
          <object id="core-identity-jobs" label="&lt;b&gt;jobs.py&lt;/b&gt;&lt;br&gt;identity.purge_expired_records&lt;br&gt;periodic 03:17 daily: OTPs, dead sessions, rate_limits" status="implemented" milestone="M1" source="backend/app/modules/identity/jobs.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="330" height="65" as="geometry"/></mxCell></object>
          <object id="core-identity-rule" label="&lt;b&gt;Module boundary rule&lt;/b&gt; (CLAUDE.md)&lt;br&gt;A module imports only app.core and another module's service.py; cross-module side effects only via events.&lt;br&gt;Enforced by tests/test_architecture.py: absolute imports only (relative imports not checked); core may import only modules.registry; every module dir registered. The 'events, not direct calls' half is not machine-checked." status="implemented" milestone="M0" source="CLAUDE.md; backend/tests/test_architecture.py"><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="530" width="720" height="100" as="geometry"/></mxCell></object>
