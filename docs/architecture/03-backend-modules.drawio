        <mxCell id="notif-mod-box" value="modules/notifications (M6A, D103-D115): in-app rows, bell, preferences, mutes, network fan-out, purge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1140" height="700" as="geometry" /></mxCell>
        <object id="notif-mod-router" label="&lt;b&gt;router.py&lt;/b&gt; (/api, CurrentUser, own rows only; another person's id is 404)&lt;br&gt;GET /notifications (?cursor, ?unread)&lt;br&gt;GET /notifications/unread-count&lt;br&gt;POST /notifications/seen, /read-all&lt;br&gt;POST /notifications/{id}/read, /{id}/unread&lt;br&gt;GET / PUT /notifications/preferences&lt;br&gt;PUT / DELETE /notifications/mutes&lt;br&gt;limits: rate_read 300/60, rate_write 60/60 per account" status="implemented" milestone="M6A" source="backend/app/modules/notifications/router.py; backend/app/modules/registry.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="330" height="190" as="geometry" /></mxCell></object>
        <object id="notif-mod-handlers" label="&lt;b&gt;handlers.py&lt;/b&gt; @subscribe&lt;br&gt;&lt;i&gt;deeds:&lt;/i&gt; DeedVerified (recognised, deed_verified for invites, starts the network fan-out)&lt;br&gt;&lt;i&gt;feed:&lt;/i&gt; DeedLiked, CommentPosted (comment + capped reply), UserFollowed, CommentModerationDecided&lt;br&gt;&lt;i&gt;media:&lt;/i&gt; PhotoModerationDecided, PhotoRemovedByDoer, AvatarModerationDecided&lt;br&gt;&lt;i&gt;scoring:&lt;/i&gt; BadgeAwarded, HeroTitleAwarded, AwardWithdrawn (marks the award row withdrawn, sends nothing)&lt;br&gt;&lt;i&gt;identity:&lt;/i&gt; PasswordChanged&lt;br&gt;&lt;i&gt;fraud:&lt;/i&gt; MemberReviewUpdate, ReviewsSeen only (D112)" status="implemented" milestone="M6A" source="backend/app/modules/notifications/handlers.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="345" width="330" height="235" as="geometry" /></mxCell></object>
        <object id="notif-mod-jobs" label="&lt;b&gt;jobs.py&lt;/b&gt; (queue notifications)&lt;br&gt;notifications.fanout_network (every 10 s, up to 20 batches a run)&lt;br&gt;notifications.purge (22:10 UTC = 03:40 IST)" status="implemented" milestone="M6A" source="backend/app/modules/notifications/jobs.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="595" width="330" height="80" as="geometry" /></mxCell></object>
        <object id="notif-mod-service" label="&lt;b&gt;service.py&lt;/b&gt; gathers the module's own operations for its router, handlers and jobs. Nobody imports notifications, not even its service (D104)" status="implemented" milestone="M6A" source="backend/app/modules/notifications/service.py; backend/tests/test_architecture.py#test_nobody_imports_notifications"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="330" height="90" as="geometry" /></mxCell></object>
        <mxCell id="notif-mod-priv" value="private files (_name.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="135" width="745" height="440" as="geometry" /></mxCell>
        <object id="notif-mod-write" label="&lt;b&gt;_write.py&lt;/b&gt; notify(): skip the actor, inactive accounts, switched-off categories, mutes; grouped kinds (network, like, comment, reply, follow) count each actor once via notification_dedupe and bump the unread row; others insert with ON CONFLICT (user_id, dedupe_key) DO NOTHING; daily caps per IST day (activity 30, network 1)" status="implemented" milestone="M6A" source="backend/app/modules/notifications/_write.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="165" width="350" height="120" as="geometry" /></mxCell></object>
        <object id="notif-mod-fanout" label="&lt;b&gt;_fanout.py&lt;/b&gt; start_fanout (in the DeedVerified handler): per-actor cap 3 fan-outs a day (dedupe claim under an advisory lock) → notification_fanouts row running. fanout_step: SKIP LOCKED, 1000 followers per batch, cursor saved, visible_deed_ids check, stops at 5000 (capped). Network rows hold no deed id (SEC6-L1)" status="implemented" milestone="M6A" source="backend/app/modules/notifications/_fanout.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="165" width="350" height="120" as="geometry" /></mxCell></object>
        <object id="notif-mod-render" label="&lt;b&gt;_render.py + _catalogue.py&lt;/b&gt; text built at read time from ids; hidden or withdrawn deeds read &amp;quot;This deed is no longer available&amp;quot; (Q93); withdrawn awards &amp;quot;This is no longer available&amp;quot;; inactive actors &amp;quot;Unavailable account&amp;quot;; neutral review wording (D101)" status="implemented" milestone="M6A" source="backend/app/modules/notifications/_render.py; backend/app/modules/notifications/_catalogue.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="300" width="350" height="100" as="geometry" /></mxCell></object>
        <object id="notif-mod-reads" label="&lt;b&gt;_reads.py + _cursor.py&lt;/b&gt; keyset list, unread count, seen, read / unread, read-all" status="implemented" milestone="M6A" source="backend/app/modules/notifications/_reads.py; backend/app/modules/notifications/_cursor.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="350" height="55" as="geometry" /></mxCell></object>
        <object id="notif-mod-prefs" label="&lt;b&gt;_prefs.py&lt;/b&gt; preferences per category (Account &amp;amp; safety and Reviews locked on, 409); silent mutes per person or deed (max 500)" status="implemented" milestone="M6A" source="backend/app/modules/notifications/_prefs.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="365" width="350" height="65" as="geometry" /></mxCell></object>
        <object id="notif-mod-purge" label="&lt;b&gt;_purge.py&lt;/b&gt; rows 90 days after last update, dedupe keys after 30 days (grouped claims kept while their group lives, SEC6-L5), finished fan-outs, daily counters after 7 days" status="implemented" milestone="M6A" source="backend/app/modules/notifications/_purge.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="415" width="350" height="80" as="geometry" /></mxCell></object>
        <object id="notif-mod-limits" label="&lt;b&gt;_limits.py&lt;/b&gt; NotificationsConfig (namespace notifications, v1 in 0030; replies.max_recipients_per_comment 200 added by 0034)" status="implemented" milestone="M6A" source="backend/app/modules/notifications/_limits.py; backend/alembic/versions/2026_11_27_0000-0030_notifications.py; backend/alembic/versions/2026_11_28_0000-0034_notifications_sec6.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="445" width="350" height="70" as="geometry" /></mxCell></object>
        <object id="notif-mod-tables" label="&lt;b&gt;models.py tables&lt;/b&gt; (migration 0030; none append-only)&lt;br&gt;notifications, notification_views, notification_preferences, notification_mutes, notification_dedupe, notification_fanouts, notification_daily_counts" status="implemented" milestone="M6A" source="backend/app/modules/notifications/models.py; backend/alembic/versions/2026_11_27_0000-0030_notifications.py"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="590" width="350" height="90" as="geometry" /></mxCell></object>
        <object id="notif-mod-events" label="&lt;b&gt;emits nothing&lt;/b&gt;: notifications is a pure subscriber (no events.py)" status="implemented" milestone="M6A" source="backend/app/modules/notifications/handlers.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="590" width="350" height="50" as="geometry" /></mxCell></object>
