        <object id="media-mod-owners" label="&lt;b&gt;_owners.py&lt;/b&gt; attach (≤ 4, 24 h, blur regions), owner views, uploader / doer removal (objects deleted after commit), exact-copy re-upload block (Q29, L5)" status="implemented" milestone="M3" source="backend/app/modules/media/_owners.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="235" width="350" height="80" as="geometry" /></mxCell></object>
