        <mxCell id="media-mod-e2" value="batches" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.84;entryDx=0;entryDy=0;" edge="1" parent="1" source="media-mod-jobs" target="media-mod-priv"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
        <mxCell id="media-mod-e3" value="service.py calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=1;exitY=0.07;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="media-mod-priv" target="media-mod-deeds"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
        <mxCell id="media-mod-e4" value="visibility" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="media-mod-router" target="media-mod-feed"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="225" y="115" /><mxPoint x="1190" y="115" /><mxPoint x="1190" y="330" /></Array></mxGeometry></mxCell>
        <mxCell id="media-mod-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=1;exitY=0.62;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="media-mod-priv" target="media-mod-storage"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
        <mxCell id="media-mod-e6" value="S3 API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="media-mod-storage" target="media-mod-bucket"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
        <mxCell id="media-mod-e7" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="media-mod-priv" target="media-mod-tables"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
