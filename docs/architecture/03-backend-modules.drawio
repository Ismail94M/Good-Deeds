        <mxCell id="media-mod-box" value="modules/media (M3, D29): uploads, storage keys, photo pipeline, signed URLs, photo reports, admin decisions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1140" height="660" as="geometry" /></mxCell>
        <object id="media-mod-router" label="&lt;b&gt;router.py&lt;/b&gt; (/api)&lt;br&gt;GET /media/options&lt;br&gt;POST /media/uploads (+ /{id}/complete), DELETE /media/uploads/{id}&lt;br&gt;POST /media/deeds/{id}/photos (D31), /self-logs/{id}/photos&lt;br&gt;GET  /media/deeds/{id}/photos, /self-logs/{id}/photos&lt;br&gt;DELETE /media/photos/{id} (uploader Q30, doer Q29)&lt;br&gt;POST /media/photos/{id}/reports (anyone, D44)&lt;br&gt;&lt;i&gt;M6A:&lt;/i&gt; PUT / GET / DELETE /media/me/avatar, POST /media/avatars/urls (signed in), GET /users/{handle}/avatar-report-target&lt;br&gt;&lt;i&gt;ReviewerUser (moderator or admin, Q34):&lt;/i&gt;&lt;br&gt;GET /admin/photo-reports (+ /{case_id})&lt;br&gt;POST /admin/photo-reports/{case_id}/decision&lt;br&gt;POST /admin/photos/{id}/restore" status="implemented" milestone="M3" source="backend/app/modules/media/router.py; backend/app/modules/registry.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="330" height="250" as="geometry" /></mxCell></object>
        <object id="media-mod-jobs" label="&lt;b&gt;jobs.py&lt;/b&gt; (queue media)&lt;br&gt;process_queued every 5 s · move_objects 1 min&lt;br&gt;purge_deleted, sweep_late_puts 5 min&lt;br&gt;expire_uploads 30 min · purge_detached hourly&lt;br&gt;purge_removed 02:23 · sweep_staging 02:53" status="implemented" milestone="M3" source="backend/app/modules/media/jobs.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="330" height="100" as="geometry" /></mxCell></object>
        <object id="media-mod-service" label="&lt;b&gt;service.py&lt;/b&gt; (public surface)&lt;br&gt;public_photos(deed_ids): ready, takedown none, deed photos only&lt;br&gt;sign_variants, admin_signed, admin_photo_urls&lt;br&gt;M6A: avatar_urls (refs → signed URLs or null), event classes&lt;br&gt;never imports feed (D30)" status="implemented" milestone="M3" source="backend/app/modules/media/service.py; backend/tests/test_architecture.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="330" height="110" as="geometry" /></mxCell></object>
