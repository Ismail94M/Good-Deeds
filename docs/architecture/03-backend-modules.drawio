          <mxCell id="deeds-mod-box" value="modules/deeds (M2): one module for scans, deeds, grouping, invites, edit/withdraw, self-logs" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fillColor=none;strokeColor=#82b366;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1140" height="640" as="geometry" /></mxCell>
          <mxCell id="deeds-mod-priv" value="private files (_name.py)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fillColor=none;strokeColor=#999999;rounded=0;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="420" y="135" width="745" height="440" as="geometry" /></mxCell>
          <object id="deeds-mod-router" label="&lt;b&gt;router.py&lt;/b&gt; (/api)&lt;br&gt;POST /scans, GET /scans/{id}&lt;br&gt;POST /deeds (qr_scan or invite)&lt;br&gt;GET /deeds/options, GET /deeds/{id}&lt;br&gt;PATCH /deeds/{id}, POST /deeds/{id}/withdraw&lt;br&gt;GET /invites/by-token/{token}, POST .../accept&lt;br&gt;POST /invites/{id}/reissue&lt;br&gt;&lt;i&gt;(invite create / preview / accept / reissue:&lt;br&gt;403 invites_disabled while off, D17)&lt;/i&gt;&lt;br&gt;GET /me/deeds, GET /me/invites&lt;br&gt;/me/self-logs (GET, POST, PATCH, DELETE)&lt;br&gt;GET /users/{handle}/deed-counts (public)" status="implemented" milestone="M2" source="backend/app/modules/deeds/router.py; backend/app/modules/registry.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="330" height="260" as="geometry" /></mxCell></object>
          <object id="deeds-mod-service" label="&lt;b&gt;service.py&lt;/b&gt; (public surface)&lt;br&gt;get_deed, get_deeds (batch, M3), deeds_for_doer,&lt;br&gt;same_act_group_view, area_name, category_labels,&lt;br&gt;self_log_owner (M3); re-exports the deed events&lt;br&gt;views never hold coordinates or a pending deed's doer" status="implemented" milestone="M3" source="backend/app/modules/deeds/service.py" details="No caller outside deeds yet; for Feed, Scoring, Fraud from M3."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="330" height="100" as="geometry" /></mxCell></object>
          <object id="deeds-mod-jobs" label="&lt;b&gt;jobs.py&lt;/b&gt;&lt;br&gt;deeds.expire_invites (every 15 min)&lt;br&gt;deeds.purge_unconsumed_scans (daily 03:37)" status="implemented" milestone="M2" source="backend/app/modules/deeds/jobs.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="330" height="80" as="geometry" /></mxCell></object>
          <object id="deeds-mod-scans" label="&lt;b&gt;_scans.py + _plausibility.py&lt;/b&gt;&lt;br&gt;accepted scans; rate limits (+ 60/day per typed ID, L4); monthly pre-checks (total, then pair with the doer in the error, D27); accuracy, service area, travel speed" status="implemented" milestone="M2" source="backend/app/modules/deeds/_scans.py; backend/app/modules/deeds/_plausibility.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="165" width="350" height="80" as="geometry" /></mxCell></object>
          <object id="deeds-mod-qrdeeds" label="&lt;b&gt;_qr_deeds.py&lt;/b&gt;&lt;br&gt;QR path of POST /deeds: monthly limits, consume scan, verify; grouped by scanned_at (D28)" status="implemented" milestone="M2" source="backend/app/modules/deeds/_qr_deeds.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="253" width="350" height="65" as="geometry" /></mxCell></object>
          <object id="deeds-mod-grouping" label="&lt;b&gt;_grouping.py&lt;/b&gt;&lt;br&gt;same_act lock, PostGIS match on server time (D28), cap, prize-rank upgrade and revoke, promotion after withdrawal" status="implemented" milestone="M2" source="backend/app/modules/deeds/_grouping.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="326" width="350" height="72" as="geometry" /></mxCell></object>
          <object id="deeds-mod-invites" label="&lt;b&gt;_invites.py&lt;/b&gt; (switched off, D17)&lt;br&gt;create, preview, accept, reissue, expiry batch; accept: suspended reporter → 404, pair limit (D21)" status="partial" milestone="M2" source="backend/app/modules/deeds/_invites.py; backend/app/modules/deeds/router.py; backend/alembic/versions/2026_11_16_0000-0007_deeds_v2.py" details="ensure_enabled() refuses create, preview, accept and reissue while deeds.invites_enabled is false (migration 0007). The expiry job still runs."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="435" y="406" width="350" height="72" as="geometry" /></mxCell></object>
<object id="deeds-mod-reporterlimit" label="&lt;b&gt;_reporter_limit.py&lt;/b&gt; (Revision 5)&lt;br&gt;reporter_month lock; per IST month 150 per reporter and 15 per reporter-doer pair (D19); unlocked pre-checks at scan time" status="implemented" milestone="M2" source="backend/app/modules/deeds/_reporter_limit.py; backend/alembic/versions/2026_11_17_0000-0008_deeds_v3.py" details="Every deeds row the reporter created that month counts, whatever its status, so withdrawing frees nothing. Errors 429 monthly_report_limit and 429 pair_monthly_limit."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="435" y="486" width="350" height="72" as="geometry" /></mxCell></object>
          <object id="deeds-mod-edits" label="&lt;b&gt;_edits.py&lt;/b&gt;&lt;br&gt;edit (deed_revisions), withdraw" status="implemented" milestone="M2" source="backend/app/modules/deeds/_edits.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="170" width="350" height="60" as="geometry" /></mxCell></object>
          <object id="deeds-mod-selflogs" label="&lt;b&gt;_self_logs.py&lt;/b&gt;&lt;br&gt;private self-logs; public Self-log and Verified Deeds counts (counted reports only, D15)" status="implemented" milestone="M2" source="backend/app/modules/deeds/_self_logs.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="240" width="350" height="60" as="geometry" /></mxCell></object>
          <object id="deeds-mod-reads" label="&lt;b&gt;_reads.py, _views.py, _cursor.py&lt;/b&gt; my deeds, detail, options; area_name (M3)" status="implemented" milestone="M2" source="backend/app/modules/deeds/_reads.py; backend/app/modules/deeds/_views.py; backend/app/modules/deeds/_cursor.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="310" width="350" height="50" as="geometry" /></mxCell></object>
          <object id="deeds-mod-retention" label="&lt;b&gt;_retention.py&lt;/b&gt;&lt;br&gt;purge unconsumed scans in batches" status="implemented" milestone="M2" source="backend/app/modules/deeds/_retention.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="368" width="350" height="32" as="geometry" /></mxCell></object>
          <object id="deeds-mod-limits" label="&lt;b&gt;_limits.py&lt;/b&gt; DeedLimits (namespace deeds, v6)&lt;br&gt;every deeds limit; no defaults. v2-v4: reporter_monthly_limit 150, reporter_doer_monthly_limit 15, invites_enabled false, rate_manual_target_daily 60/day. v5 (0013): photos_enabled moved to media, area_fallback_m 1500. v6 (0018): warning thresholds reporter_monthly_warn_at 10, reporter_doer_monthly_warn_at 3 (sent in /deeds/options)" status="implemented" milestone="M3" source="backend/app/modules/deeds/_limits.py; backend/alembic/versions/2026_11_13_0000-0004_runtime_config.py; backend/alembic/versions/2026_11_16_0000-0007_deeds_v2.py; backend/alembic/versions/2026_11_17_0000-0008_deeds_v3.py; backend/alembic/versions/2026_11_17_0100-0009_deeds_v4.py; backend/alembic/versions/2026_11_19_0000-0013_deeds_v5.py; backend/alembic/versions/2026_11_21_0200-0018_deeds_v6.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="466" width="350" height="100" as="geometry" /></mxCell></object>
          <object id="deeds-mod-tables" label="&lt;b&gt;models.py tables&lt;/b&gt; (migrations 0005, 0007, 0013, 0017)&lt;br&gt;qr_scans, same_act_groups, deeds (+ area_id, M3),&lt;br&gt;invites, verification_events (append-only),&lt;br&gt;deed_revisions (append-only), self_logs,&lt;br&gt;areas (M3: 369 ward polygons, GiST)&lt;br&gt;locations: geography(Point, 4326); ix_deeds_doer_counted" status="implemented" milestone="M3" source="backend/app/modules/deeds/models.py; backend/alembic/versions/2026_11_13_0100-0005_deeds.py; backend/alembic/versions/2026_11_16_0000-0007_deeds_v2.py; backend/alembic/versions/2026_11_19_0000-0013_deeds_v5.py; backend/alembic/versions/2026_11_21_0100-0017_real_ward_areas.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="600" width="360" height="120" as="geometry" /></mxCell></object>
          <object id="deeds-mod-events" label="&lt;b&gt;events.py&lt;/b&gt;&lt;br&gt;DeedSubmitted, DeedVerified, DeedRejected,&lt;br&gt;DeedPrizeRankChanged, DeedEdited,&lt;br&gt;DeedWithdrawn, DeedCountsForPointsChanged&lt;br&gt;(IDs only). M3: feed subscribes DeedVerified,&lt;br&gt;DeedWithdrawn, DeedRejected; the rest have none" status="implemented" milestone="M3" source="backend/app/modules/deeds/events.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="600" width="365" height="120" as="geometry" /></mxCell></object>
          <object id="deeds-mod-identity" label="&lt;b&gt;identity service.py&lt;/b&gt; (used by deeds)&lt;br&gt;OnboardedUser, CurrentUser, DeviceId,&lt;br&gt;resolve_qr_token, resolve_manual_code,&lt;br&gt;phone_hashes, phone_hash, device_hash(es),&lt;br&gt;normalize_short_id, is_active (M2)" status="implemented" milestone="M2" source="backend/app/modules/identity/service.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="100" width="340" height="130" as="geometry" /></mxCell></object>
          <object id="deeds-mod-rc" label="&lt;b&gt;core.runtime_config&lt;/b&gt;&lt;br&gt;load(DeedLimits) → (version, limits); limits_version stored on rows" status="implemented" milestone="M2" source="backend/app/core/runtime_config.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="300" width="340" height="70" as="geometry" /></mxCell></object>
          <object id="deeds-mod-lock" label="&lt;b&gt;core.db&lt;/b&gt; advisory_xact_lock('reporter_month' | 'same_act' | 'invites' | 'shared_device', ...)" status="implemented" milestone="M2" source="backend/app/core/db.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="385" width="340" height="55" as="geometry" /></mxCell></object>
          <object id="deeds-mod-audit" label="&lt;b&gt;core.audit&lt;/b&gt; record_audit: prize_rank_eligible granted / revoked, counts_for_points granted" status="implemented" milestone="M2" source="backend/app/core/audit.py; backend/app/modules/deeds/_grouping.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="455" width="340" height="60" as="geometry" /></mxCell></object>
          <object id="deeds-mod-outbox" label="&lt;b&gt;core.events&lt;/b&gt; emit() → outbox_events" status="implemented" milestone="M0" source="backend/app/core/events.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="530" width="340" height="45" as="geometry" /></mxCell></object>
          <object id="deeds-mod-rl" label="&lt;b&gt;core.ratelimit + core.errors&lt;/b&gt; Limiter (account and IP keys); Gone (410); AppError.extra (D27)" status="implemented" milestone="M2" source="backend/app/core/ratelimit.py; backend/app/core/errors.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="590" width="340" height="55" as="geometry" /></mxCell></object>
          <object id="deeds-mod-rule" label="&lt;b&gt;Rules&lt;/b&gt; (CLAUDE.md). Lock order, QR deed: reporter_month → scan row → same_act → deed rows. Invite create: reporter_month → invites. Accept: reporter_month (reporter read unlocked first) → invite row → shared_device → pending deed row → same_act. Withdraw: invite row → same_act → deed row. Responses and event payloads never hold coordinates, phone numbers or free text, and never name a pending deed's doer. Non-owners get 404." status="implemented" milestone="M2" source="CLAUDE.md; backend/app/modules/deeds/_edits.py; backend/app/modules/deeds/_invites.py; backend/app/modules/deeds/_qr_deeds.py; backend/app/modules/deeds/_reporter_limit.py"><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="765" width="1140" height="80" as="geometry" /></mxCell></object>
          <mxCell id="deeds-mod-e1" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="deeds-mod-router" target="deeds-mod-priv"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
          <mxCell id="deeds-mod-e2" value="batches" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.76;entryDx=0;entryDy=0;" edge="1" parent="1" source="deeds-mod-jobs" target="deeds-mod-priv"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
          <mxCell id="deeds-mod-e3" value="service.py calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="deeds-mod-priv" target="deeds-mod-identity"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
          <mxCell id="deeds-mod-e4" value="app.core" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="deeds-mod-priv" target="deeds-mod-rc"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
          <mxCell id="deeds-mod-e5" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.24;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="deeds-mod-priv" target="deeds-mod-tables"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
          <mxCell id="deeds-mod-e6" value="emit()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.76;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="deeds-mod-priv" target="deeds-mod-events"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell>
