          <object id="onboarding-apisignup" label="POST /auth/signup: argon2 hash, 18+ (IST), consents, doer_codes, emit UserRegistered; session + refresh cookie" status="implemented" milestone="M1" source="backend/app/modules/identity/router.py; backend/app/modules/identity/service.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="110" y="420" width="250" height="100" as="geometry" /></mxCell></object>
          <object id="onboarding-apiage" label="POST /users/me/age-consent: 18+ in Asia/Kolkata, consent rows, adult_declared_at, record device" status="implemented" milestone="M1" source="backend/app/modules/identity/router.py; backend/app/modules/identity/service.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="420" width="250" height="100" as="geometry" /></mxCell></object>
          <object id="onboarding-apistart" label="POST /users/me/phone/start: IN mobiles only, phone_history check, rate limits (IP 10/h, SMS 500/h, resend 30 s, 5/h counting phone_verify codes only); hashed OTP, 10 min" status="implemented" milestone="M1" source="backend/app/modules/identity/router.py; backend/app/modules/identity/service.py; backend/app/core/config.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1070" y="420" width="250" height="110" as="geometry" /></mxCell></object>
          <object id="onboarding-apiverify" label="POST /users/me/phone/verify: 20/h per user, 5 attempts; only codes with purpose phone_verify (M2); phone_verified_at, phone_history; emit PhoneVerified" status="implemented" milestone="M1" source="backend/app/modules/identity/router.py; backend/app/modules/identity/service.py; backend/alembic/versions/2026_11_17_0300-0011_identity_password_reset.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1390" y="420" width="250" height="110" as="geometry" /></mxCell></object>
