          <object id="qr-qrcode" label="service.qr_code: onboarding gate, doer_codes; token = short_id.window.sig (keyed_hash 'qr'), 30 s window → display_id, token, scan_url, expires_at, refresh_after_seconds" status="implemented" milestone="M1" source="backend/app/modules/identity/service.py; backend/app/modules/identity/_qr.py; backend/app/modules/identity/router.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="300" height="120" as="geometry"/></mxCell></object>
