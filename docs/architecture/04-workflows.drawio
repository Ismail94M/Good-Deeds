          <object id="qr-qrcode" label="service.qr_code: onboarding gate, doer_codes; token = short_id.window.sig (keyed_hash 'qr') → display_id, token, scan_url, manual_code, expires_at, refresh_after_seconds, window_seconds" status="implemented" milestone="M2" source="backend/app/modules/identity/service.py; backend/app/modules/identity/_qr.py; backend/app/modules/identity/router.py; backend/app/modules/identity/schemas.py" details="Built in M1; M2 added manual_code and moved the window settings to the qr config namespace."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="300" height="110" as="geometry" /></mxCell></object>
