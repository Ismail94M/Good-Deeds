          <object id="qr-resolve" label="resolve_qr_token: strict parse, active onboarded doer, token window ≤ 2 grace windows old (60-90 s), constant-time signature check" status="partial" milestone="M1" source="backend/app/modules/identity/service.py; backend/app/modules/identity/_qr.py" details="Implemented and tested, but no route calls it yet (M2)"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="860" y="380" width="300" height="100" as="geometry"/></mxCell></object>
          <object id="qr-resolveid" label="resolve_short_id: normalises typed GD-xxxxxxx; identifies only, never verifies alone" status="partial" milestone="M1" source="backend/app/modules/identity/service.py; backend/app/modules/identity/_qr.py" details="No caller yet; security review H3 in docstring"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="380" width="300" height="100" as="geometry"/></mxCell></object>
          <object id="qr-cam" label="Witness's phone camera opens scan_url" status="implemented" milestone="M1" source="backend/app/modules/identity/service.py; frontend/src/app/routes.tsx"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="660" width="300" height="70" as="geometry"/></mxCell></object>
          <object id="qr-scanpage" label="/scan/:token → ScanPage: static 'arrives in the next update' text; ignores the token, calls no API" status="partial" milestone="M1" source="frontend/src/features/scan/ScanPage.tsx; frontend/src/app/routes.tsx" details="Route is mounted; page is a placeholder"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470" y="650" width="300" height="90" as="geometry"/></mxCell></object>
          <object id="qr-scanapi" label="Scan endpoint consumes the token → resolve_qr_token + time/location plausibility (M2)" status="planned" milestone="M2" source="docs/ROADMAP.md; docs/PRD.md#5-verification; backend/app/modules/identity/service.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="860" y="650" width="300" height="90" as="geometry"/></mxCell></object>
          <object id="qr-code6" label="Manual fallback: GD-xxxxxxx + 6-digit rotating code from the same signed window (proposed)" status="proposed" milestone="M2" source="docs/ROADMAP.md; backend/app/modules/identity/_qr.py" details="Proposed; elaborates ROADMAP M2 'manual ID fallback must not be static'"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;dashPattern=1 4;" vertex="1" parent="1"><mxGeometry x="1250" y="650" width="300" height="90" as="geometry"/></mxCell></object>
