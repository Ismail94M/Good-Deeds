          <object id="edits-withdraw" label="&lt;b&gt;POST /api/deeds/{id}/withdraw&lt;/b&gt;: locks the invite row, then same_act, then the deed row; status → withdrawn (final); verification_events(withdrawn); emit DeedWithdrawn" status="implemented" milestone="M2" source="backend/app/modules/deeds/router.py; backend/app/modules/deeds/_edits.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="260" height="120" as="geometry"/></mxCell></object>
          <object id="edits-pending" label="Was pending: invite → cancelled; preview and accept now return 410 invite_cancelled" status="implemented" milestone="M2" source="backend/app/modules/deeds/_edits.py; backend/app/modules/deeds/_invites.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="730" y="470" width="260" height="80" as="geometry"/></mxCell></object>
          <object id="edits-group" label="Was verified: withdraw_from_group: verified_count − 1, counted_count − 1 if it counted, recount distinct_reporters" status="implemented" milestone="M2" source="backend/app/modules/deeds/_grouping.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="730" y="300" width="260" height="100" as="geometry"/></mxCell></object>
          <object id="edits-promote" label="&lt;b&gt;Promotion (D13)&lt;/b&gt;: if the withdrawn deed counted, the oldest verified uncounted report whose reporter has no counted deed in the group gets counts_for_points; audit_log; at most one per withdrawal" status="implemented" milestone="M2" source="backend/app/modules/deeds/_grouping.py; backend/app/core/audit.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1040" y="300" width="260" height="120" as="geometry"/></mxCell></object>
