        <object id="moderation-prep" label="&lt;b&gt;ReportPhotoSheet&lt;/b&gt; anyone, visitors too (D44, per-IP limit): children · privacy · harmful · something else" status="implemented" milestone="M3" source="frontend/src/features/media/ReportPhotoSheet.tsx"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="290" height="100" as="geometry" /></mxCell></object>
