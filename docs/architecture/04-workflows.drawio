          <object id="qr-manualui" label="Show the 6-digit manual code next to the QR (F2) (M2)" status="planned" milestone="M2" source="frontend/src/features/auth/identityApi.ts; docs/M2-DESIGN.md#5-ui-flows-frontend-developer" details="The API already returns manual_code (QrCodeResponse) and identityApi.ts types it. Screen not built: frontend M2 screens wait for the product owner's Figma designs."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="860" y="140" width="300" height="90" as="geometry"/></mxCell></object>
          <object id="qr-qrcode" label="service.qr_code: onboarding gate, doer_codes; token = short_id.window.sig (keyed_hash 'qr') → display_id, token, scan_url, manual_code, expires_at, refresh_after_seconds" status="implemented" milestone="M2" source="backend/app/modules/identity/service.py; backend/app/modules/identity/_qr.py; backend/app/modules/identity/router.py; backend/app/modules/identity/schemas.py" details="Built in M1; M2 added manual_code and moved the window settings to the qr config namespace."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="300" height="110" as="geometry"/></mxCell></object>
          <object id="qr-rotate" label="rotate_qr_key: key_version + 1 invalidates every earlier token and code" status="implemented" milestone="M1" source="backend/app/modules/identity/service.py; backend/app/modules/identity/router.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="330" width="300" height="60" as="geometry"/></mxCell></object>
          <object id="qr-resolve" label="resolve_qr_token → ResolvedDoer (user_id, handle, window): strict parse, active onboarded doer, own window + 1 grace window, constant-time signature check" status="implemented" milestone="M2" source="backend/app/modules/identity/service.py; backend/app/modules/identity/_qr.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="320" width="300" height="100" as="geometry"/></mxCell></object>
          <object id="qr-resolvecode" label="resolve_manual_code (GD-xxxxxxx + 6-digit code): tries each accepted window; unknown ID and wrong code both give 404 doer_code_invalid. resolve_short_id removed" status="implemented" milestone="M2" source="backend/app/modules/identity/service.py; backend/app/modules/identity/_qr.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="320" width="300" height="110" as="geometry"/></mxCell></object>
          <object id="qr-config" label="&lt;b&gt;qr config namespace&lt;/b&gt; (config_versions, v1 seeded by migration 0004): window_seconds = 30, grace_windows = 1 → a token or code is accepted 30-60 s" status="implemented" milestone="M2" source="backend/app/modules/identity/_qr.py; backend/app/core/runtime_config.py; backend/alembic/versions/2026_11_13_0000-0004_runtime_config.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="480" width="300" height="90" as="geometry"/></mxCell></object>
          <object id="qr-scanapi" label="&lt;b&gt;POST /api/scans&lt;/b&gt; (deeds/_scans.py), OnboardedUser: account + IP rate limits (typed codes also per target) before any lookup; not self, no shared phone_history; plausibility: accuracy ≤ 500 m, within 40 km of Bangalore, witness and doer travel ≤ 80 km/h" status="implemented" milestone="M2" source="backend/app/modules/deeds/router.py; backend/app/modules/deeds/_scans.py; backend/app/modules/deeds/_plausibility.py; backend/app/modules/deeds/_limits.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="480" width="300" height="150" as="geometry"/></mxCell></object>
