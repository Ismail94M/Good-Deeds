          <object id="edits-mydeeds" label="MyDeedsPage / DeedDetailPage: edit and withdraw buttons (F6) (M2)" status="planned" milestone="M2" source="docs/M2-DESIGN.md#5-ui-flows-frontend-developer; frontend/src/features/deeds/deedsApi.ts" details="Screen not built: frontend M2 screens wait for the product owner's Figma designs."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="140" width="260" height="80" as="geometry"/></mxCell></object>
          <object id="edits-edit" label="&lt;b&gt;PATCH /api/deeds/{id}&lt;/b&gt;: reporter only (anyone else 404); pending or verified; content fields only (category, description, people helped); time, place, doer and method never change" status="implemented" milestone="M2" source="backend/app/modules/deeds/router.py; backend/app/modules/deeds/_edits.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="110" y="300" width="260" height="120" as="geometry"/></mxCell></object>
