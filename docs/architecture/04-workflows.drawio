        <object id="moderation-outcome" label="&lt;b&gt;Outcomes&lt;/b&gt;: the uploader sees removed or kept in My deeds for 30 days (PhotoOutcomeBanner, Q39); a comment author gets a removed notice (/feed/me/comment-notices)" status="implemented" milestone="M3" source="frontend/src/features/media/PhotoOutcomeBanner.tsx; frontend/src/features/feed/FeedNotices.tsx; backend/app/modules/feed/_notices.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="130" width="380" height="100" as="geometry" /></mxCell></object>
        <object id="moderation-guides" label="Photo and community guidelines pages (copy awaits PO approval before launch)" status="partial" milestone="M3" source="frontend/src/features/legal/PhotoGuidelinesPage.tsx; frontend/src/features/legal/CommunityGuidelinesPage.tsx; docs/ROADMAP.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1130" y="130" width="290" height="100" as="geometry" /></mxCell></object>
        <object id="moderation-pcase" label="&lt;b&gt;POST /api/media/photos/{id}/reports&lt;/b&gt; → 202; one open case per photo; priority 1 children, 2 privacy and harmful, 3 other (Q44); never hides or changes anything (D42)" status="implemented" milestone="M3" source="backend/app/modules/media/router.py; backend/app/modules/media/_reports.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="310" width="290" height="110" as="geometry" /></mxCell></object>
        <object id="moderation-ccase" label="&lt;b&gt;POST /api/feed/comments/{id}/reports&lt;/b&gt; one case per comment, the same shape as photo cases (D45)" status="implemented" milestone="M3" source="backend/app/modules/feed/router.py; backend/app/modules/feed/_reports.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="310" width="290" height="110" as="geometry" /></mxCell></object>
        <object id="moderation-pdec" label="&lt;b&gt;POST /api/admin/photo-reports/{case}/decision&lt;/b&gt; keep | remove (reason) with a required note; &lt;b&gt;POST /api/admin/photos/{id}/restore&lt;/b&gt;; photo_decisions (append-only) + audit_log; emit PhotoModerationDecided" status="implemented" milestone="M3" source="backend/app/modules/media/_admin.py; backend/app/modules/media/events.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="300" width="380" height="120" as="geometry" /></mxCell></object>
        <object id="moderation-cdec" label="&lt;b&gt;POST /api/admin/comment-reports/{case}/decision&lt;/b&gt; keep | remove; &lt;b&gt;POST /api/admin/comments/{id}/restore&lt;/b&gt;; comment_decisions + audit_log; emit CommentModerationDecided" status="implemented" milestone="M3" source="backend/app/modules/feed/_moderation.py; backend/app/modules/feed/events.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1130" y="300" width="380" height="120" as="geometry" /></mxCell></object>
        <object id="moderation-tables" label="&lt;b&gt;photo_report_cases + photo_reports&lt;/b&gt; · &lt;b&gt;comment_report_cases + comment_reports&lt;/b&gt;" status="implemented" milestone="M3" source="backend/app/modules/media/models.py; backend/app/modules/feed/models.py"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="445" width="610" height="65" as="geometry" /></mxCell></object>
        <object id="moderation-who" label="&lt;b&gt;Who reviews&lt;/b&gt;: ReviewerUser = moderator or admin (Q34); nobody decides a case on a deed they reported, did, or uploaded photos to (D43); per-user decision rate limit. Roles only via the CLI set-role --reason --operator (audited)" status="implemented" milestone="M3" source="backend/app/modules/identity/service.py#ReviewerUser; backend/app/modules/identity/cli.py; backend/app/modules/media/_admin.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="435" width="790" height="85" as="geometry" /></mxCell></object>
