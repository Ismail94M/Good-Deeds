          <object id="deeds-inviteui" label="Invite form + share panel (F4): not built in M2, D26 (unscheduled)" status="planned" milestone="unscheduled" source="docs/M2-DESIGN.md; docs/ROADMAP.md" details="Invites are switched off by config (D17). Instead the hub says: 'Doer not on Good Deeds? Ask them to sign up, then show you their QR.'"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="110" y="140" width="250" height="80" as="geometry" /></mxCell></object>
          <object id="deeds-form" label="Deed form (F3) /report/scan/:scanId: ScanDeedPage + DeedForm (category, description, people helped, When?); pair warning at ≤ 3 left; public-feed notice (D22)" status="implemented" milestone="M2" source="frontend/src/features/report/ScanDeedPage.tsx; frontend/src/features/report/DeedForm.tsx; frontend/src/features/report/deedFormValues.ts; frontend/src/features/deeds/deedsApi.ts"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="250" height="80" as="geometry" /></mxCell></object>
<object id="deeds-hub" label="Hub /report (F3): LimitBanner from GET /api/deeds/options when ≤ 10 of 150 are left; reset date from month_resets_at (D20)" status="implemented" milestone="M2" source="frontend/src/features/report/ReportHubPage.tsx; frontend/src/features/report/limits.ts; backend/app/modules/deeds/_reads.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="140" width="250" height="80" as="geometry" /></mxCell></object>
<object id="deeds-result" label="Result (F3): ReportResult on 201; ReportErrorView words 429 monthly_report_limit / pair_monthly_limit with the reset date" status="implemented" milestone="M2" source="frontend/src/features/report/ReportResult.tsx; frontend/src/features/report/ReportErrorView.tsx; frontend/src/features/report/errorCopy.ts"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1070" y="140" width="250" height="80" as="geometry" /></mxCell></object>
<object id="deeds-e18" label="201 DeedOut" status="implemented" milestone="M2" source="backend/app/modules/deeds/router.py; frontend/src/features/report/ReportResult.tsx"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="deeds-verified" target="deeds-result"><mxGeometry relative="1" as="geometry" /></mxCell></object>
          <object id="deeds-submit" label="&lt;b&gt;POST /api/deeds&lt;/b&gt; {method: qr_scan, scan_id}: read the scan's doer (no lock); take &lt;b&gt;reporter_month&lt;/b&gt;: under 150 this month (else 429 monthly_report_limit) and under 15 about this doer (else 429 pair_monthly_limit), D19; then consume the scan once (conditional UPDATE) within 15 min; occurred_at ≤ 2 h before the scan; content checked against config" status="implemented" milestone="M2" source="backend/app/modules/deeds/router.py; backend/app/modules/deeds/_qr_deeds.py; backend/app/modules/deeds/_reporter_limit.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="285" width="250" height="145" as="geometry" /></mxCell></object>
          <object id="deeds-group" label="&lt;b&gt;Same-act grouping&lt;/b&gt; under advisory_xact_lock('same_act', doer): PostGIS 200 m / 2 h of the group anchor, timed by the server (QR: scan scanned_at; invite: deed reported_at), never occurred_at (D28); cap 5 counted; one counted report per reporter; no location → group of one" status="implemented" milestone="M2" source="backend/app/modules/deeds/_grouping.py; backend/app/core/db.py; backend/app/modules/deeds/_limits.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="285" width="250" height="145" as="geometry" /></mxCell></object>
          <object id="deeds-verified" label="QR path: deed verified at once (qr_scan); verification_events row; emit DeedSubmitted + DeedVerified in the same transaction" status="implemented" milestone="M2" source="backend/app/modules/deeds/_qr_deeds.py; backend/app/modules/deeds/events.py; backend/app/modules/deeds/models.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1070" y="303" width="250" height="110" as="geometry" /></mxCell></object>
          <object id="deeds-prize" label="&lt;b&gt;Prize-rank upgrade&lt;/b&gt;: a 2nd distinct reporter in the group makes its invite deeds prize_rank_eligible; audit_log row + DeedPrizeRankChanged" status="implemented" milestone="M2" source="backend/app/modules/deeds/_grouping.py; backend/app/core/audit.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1390" y="303" width="250" height="110" as="geometry" /></mxCell></object>
          <object id="deeds-invite" label="&lt;b&gt;POST /api/deeds&lt;/b&gt; {method: invite} (off: 403 invites_disabled, D17): reporter_month lock, total limit only (doer unknown); 5 per day; occurred_at ≤ 7 days; location optional; deed pending with no doer; 256-bit token, only SHA-256 stored; emit DeedSubmitted. New link: POST /api/invites/{id}/reissue" status="partial" milestone="M2" source="backend/app/modules/deeds/router.py; backend/app/modules/deeds/_invites.py" details="Built but switched off by config: deeds.invites_enabled = false (D17, migration 0007), so the route returns 403 invites_disabled after its rate limits."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="110" y="450" width="250" height="180" as="geometry" /></mxCell></object>
          <object id="deeds-preview" label="GET /api/invites/by-token/{token} (off, D17): preview with no doer and no free text; 410 invite_expired, invite_used or invite_cancelled; no-store, no-referrer" status="partial" milestone="M2" source="backend/app/modules/deeds/router.py; backend/app/modules/deeds/_invites.py" details="Built but switched off by config: deeds.invites_enabled = false (D17, migration 0007), so the route returns 403 invites_disabled after its rate limits."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="430" y="470" width="250" height="110" as="geometry" /></mxCell></object>
          <object id="deeds-accept" label="&lt;b&gt;POST /api/invites/by-token/{token}/accept&lt;/b&gt; (off, D17). Locks: reporter_month (reporter read unlocked first) → invite row → shared_device → pending deed → same_act. Suspended reporter → 404 invite_invalid (L8); not your own invite; pair limit in the month of reported_at (D21); no shared phone_history; shared device ≤ 15 a month per pair; group by reported_at and verify (invite_accept, not yet prize-rank eligible)" status="partial" milestone="M2" source="backend/app/modules/deeds/router.py; backend/app/modules/deeds/_invites.py; backend/app/modules/deeds/_reporter_limit.py; backend/app/modules/identity/service.py" details="Built but switched off by config: deeds.invites_enabled = false (D17, migration 0007), so the route returns 403 invites_disabled after its rate limits."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="750" y="455" width="250" height="205" as="geometry" /></mxCell></object>
          <object id="deeds-events" label="&lt;b&gt;Outbox events&lt;/b&gt;&lt;br&gt;DeedSubmitted, DeedVerified, DeedRejected, DeedPrizeRankChanged&lt;br&gt;(no subscribers in M2)" status="implemented" milestone="M2" source="backend/app/modules/deeds/events.py; backend/app/core/events.py"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;size=8;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1390" y="470" width="250" height="100" as="geometry" /></mxCell></object>
          <object id="deeds-share" label="Reporter shares the link with the doer (WhatsApp, copy) (F4): not built in M2, D26 (unscheduled)" status="planned" milestone="unscheduled" source="docs/M2-DESIGN.md; docs/ROADMAP.md" details="Invite screens are deferred while invites are switched off (D17, D26)."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="110" y="710" width="250" height="80" as="geometry" /></mxCell></object>
          <object id="deeds-invitepage" label="InvitePage (/invite/:token): preview, then sign up or log in and accept (F5): not built in M2, D26 (unscheduled)" status="planned" milestone="unscheduled" source="docs/M2-DESIGN.md; docs/ROADMAP.md" details="Invite screens are deferred while invites are switched off (D17, D26)."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="430" y="710" width="250" height="80" as="geometry" /></mxCell></object>
          <object id="deeds-signup" label="Sign up + onboarding (built in M1); existing members can accept too" status="implemented" milestone="M1" source="backend/app/modules/identity/router.py; frontend/src/features/onboarding/OnboardingPage.tsx"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="710" width="250" height="80" as="geometry" /></mxCell></object>
          <object id="deeds-expiry" label="&lt;b&gt;deeds.expire_invites&lt;/b&gt; (every 15 min): pending invites older than 168 h → expired (SKIP LOCKED, batches of 200); deed → unverified, never scored; verification_events(invite_expired)" status="implemented" milestone="M2" source="backend/app/modules/deeds/jobs.py; backend/app/modules/deeds/_invites.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1070" y="870" width="250" height="120" as="geometry" /></mxCell></object>
          <object id="deeds-rejected" label="emit DeedRejected (new_status = unverified, reason = invite_expired)" status="implemented" milestone="M2" source="backend/app/modules/deeds/_invites.py; backend/app/modules/deeds/events.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1390" y="890" width="250" height="80" as="geometry" /></mxCell></object>
          <mxCell id="deeds-n" value="PRD section 5: an invite-verified deed earns points (M4) but counts for prize rank only after a second independent report of the same act (built in M2) or human review (M5). All limits on this page come from the deeds config namespace (v4). The monthly limits count every deeds row the reporter created that IST month, whatever its status, so withdrawing frees nothing. The invite expiry job keeps running while invites are off." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="110" y="1030" width="900" height="65" as="geometry" /></mxCell>
          <object id="deeds-e1" label="POST /api/deeds" status="implemented" milestone="M2" source="frontend/src/features/report/ScanDeedPage.tsx; frontend/src/features/deeds/deedsApi.ts"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#000000;" edge="1" parent="1" source="deeds-form" target="deeds-submit"><mxGeometry x="0.0" relative="1" as="geometry" /></mxCell></object>
