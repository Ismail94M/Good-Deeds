          <object id="scoring-ledger" label="Points ledger (append-only): diminishing pair returns, doer cap 10/day, same-act cap, reporter daily cap (M4)" status="planned" milestone="M4" source="docs/ROADMAP.md; docs/PRD.md#9-scoring-methodology; CLAUDE.md" details="Reporter points never count toward prize rank (PRD section 9)"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="750" y="430" width="250" height="110" as="geometry" /></mxCell></object>
