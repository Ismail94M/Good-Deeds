          <object id="pw-reset-m10" label="if OutgoingSms: background task charges sms:reset_global (200/h), then sms.send;&lt;br&gt;over budget → the code is quietly not sent (the reply was already the same 200)" status="partial" milestone="M1" source="backend/app/modules/identity/router.py; backend/app/core/sms.py; backend/alembic/versions/2026_11_17_0400-0012_identity_reset_limits.py" details="Runs after the response, so neither a slow SMS provider nor the budget check can reveal that an account exists. Reset SMS have their own budget, separate from sms:global, so resets and onboarding codes can't starve each other."><mxCell style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#d6b656;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="640" y="650" as="sourcePoint" /><mxPoint x="1420" y="650" as="targetPoint" /></mxGeometry></mxCell></object>
