        <object id="moderation-m5" label="Full admin area, score overrides, audit view (M5); two-step login for reviewers (before launch)" status="planned" milestone="M5" source="docs/ROADMAP.md#M5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="565" width="380" height="100" as="geometry" /></mxCell></object>
        <object id="moderation-hold" label="&lt;b&gt;media.move_objects&lt;/b&gt; (every minute; also run right after the request commits): hold photos/{id}/… → held/{id}/… so every issued URL returns 404 at once; release on restore under a new version" status="implemented" milestone="M3" source="backend/app/modules/media/_moves.py; backend/app/modules/media/jobs.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="380" height="110" as="geometry" /></mxCell></object>
        <object id="moderation-purge" label="&lt;b&gt;media.purge_removed&lt;/b&gt; (02:23): held/ variants deleted 90 days after removal (Q32); restore then 409 not_restorable; the decision record stays. Uploader and doer can't purge a held photo (L4)" status="implemented" milestone="M3" source="backend/app/modules/media/_cleanup.py; backend/app/modules/media/jobs.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="500" y="720" width="380" height="110" as="geometry" /></mxCell></object>
        <object id="moderation-erase" label="&lt;b&gt;feed.erase_deleted_comments&lt;/b&gt; (03:47): a removed comment's text is kept 30 days, then erased; after a moderation removal the author's delete no longer erases it early (L3)" status="implemented" milestone="M3" source="backend/app/modules/feed/jobs.py; backend/app/modules/feed/_comments.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="920" y="720" width="380" height="110" as="geometry" /></mxCell></object>
