          <mxCell id="deeds-l-doer" value="Doer (invitee)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fillColor=none;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="1660" height="170" as="geometry"/></mxCell>
          <mxCell id="deeds-l-wk" value="Worker" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fillColor=none;strokeColor=#999999;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="1660" height="170" as="geometry"/></mxCell>
          <object id="deeds-inviteui" label="'They're not on Good Deeds': InviteDeedPage + share panel (F4) (M2)" status="planned" milestone="M2" source="docs/M2-DESIGN.md#5-ui-flows-frontend-developer; frontend/src/features/deeds/deedsApi.ts" details="Screen not built: frontend M2 screens wait for the product owner's Figma designs."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="110" y="140" width="250" height="80" as="geometry"/></mxCell></object>
          <object id="deeds-form" label="After a scan: ScanDeedPage / DeedForm with category, description, people helped, time (F3) (M2)" status="planned" milestone="M2" source="docs/M2-DESIGN.md#5-ui-flows-frontend-developer; frontend/src/features/deeds/deedsApi.ts" details="Screen not built: frontend M2 screens wait for the product owner's Figma designs."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="250" height="80" as="geometry"/></mxCell></object>
          <object id="deeds-submit" label="&lt;b&gt;POST /api/deeds&lt;/b&gt; {method: qr_scan, scan_id}: consume the scan once (conditional UPDATE) within 15 min; occurred_at ≤ 2 h before the scan; content checked against config" status="implemented" milestone="M2" source="backend/app/modules/deeds/router.py; backend/app/modules/deeds/_qr_deeds.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="310" width="250" height="110" as="geometry"/></mxCell></object>
          <object id="deeds-group" label="&lt;b&gt;Same-act grouping&lt;/b&gt; under advisory_xact_lock('same_act', doer): PostGIS 200 m / 2 h of the group anchor; cap 5 counted; one counted report per reporter; no location → group of one" status="implemented" milestone="M2" source="backend/app/modules/deeds/_grouping.py; backend/app/core/db.py; backend/app/modules/deeds/_limits.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="310" width="250" height="110" as="geometry"/></mxCell></object>
          <object id="deeds-verified" label="QR path: deed verified at once (qr_scan); verification_events row; emit DeedSubmitted + DeedVerified in the same transaction" status="implemented" milestone="M2" source="backend/app/modules/deeds/_qr_deeds.py; backend/app/modules/deeds/events.py; backend/app/modules/deeds/models.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1070" y="310" width="250" height="110" as="geometry"/></mxCell></object>
          <object id="deeds-prize" label="&lt;b&gt;Prize-rank upgrade&lt;/b&gt;: a 2nd distinct reporter in the group makes its invite deeds prize_rank_eligible; audit_log row + DeedPrizeRankChanged" status="implemented" milestone="M2" source="backend/app/modules/deeds/_grouping.py; backend/app/core/audit.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1390" y="310" width="250" height="110" as="geometry"/></mxCell></object>
          <object id="deeds-invite" label="&lt;b&gt;POST /api/deeds&lt;/b&gt; {method: invite}: 5 per day per reporter; occurred_at ≤ 7 days; location optional; deed pending with no doer; 256-bit token, only SHA-256 stored; emit DeedSubmitted (pending). New link: POST /api/invites/{id}/reissue" status="implemented" milestone="M2" source="backend/app/modules/deeds/router.py; backend/app/modules/deeds/_invites.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="110" y="450" width="250" height="150" as="geometry"/></mxCell></object>
          <object id="deeds-preview" label="GET /api/invites/by-token/{token}: preview with no doer and no free text; 410 invite_expired, invite_used or invite_cancelled; no-store, no-referrer" status="implemented" milestone="M2" source="backend/app/modules/deeds/router.py; backend/app/modules/deeds/_invites.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="470" width="250" height="110" as="geometry"/></mxCell></object>
          <object id="deeds-accept" label="&lt;b&gt;POST /api/invites/by-token/{token}/accept&lt;/b&gt;: lock the invite row; not your own invite; no shared phone_history; a shared device is allowed 15 times a month per pair; group and verify (invite_accept, not yet prize-rank eligible)" status="implemented" milestone="M2" source="backend/app/modules/deeds/router.py; backend/app/modules/deeds/_invites.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="450" width="250" height="150" as="geometry"/></mxCell></object>
          <object id="deeds-events" label="&lt;b&gt;Outbox events&lt;/b&gt;&lt;br&gt;DeedSubmitted, DeedVerified, DeedRejected, DeedPrizeRankChanged&lt;br&gt;(no subscribers in M2)" status="implemented" milestone="M2" source="backend/app/modules/deeds/events.py; backend/app/core/events.py"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;size=8;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1390" y="470" width="250" height="100" as="geometry"/></mxCell></object>
          <object id="deeds-share" label="Reporter shares the link with the doer (WhatsApp, copy) (F4) (M2)" status="planned" milestone="M2" source="docs/M2-DESIGN.md#5-ui-flows-frontend-developer" details="Screen not built: frontend M2 screens wait for the product owner's Figma designs."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="110" y="710" width="250" height="80" as="geometry"/></mxCell></object>
          <object id="deeds-invitepage" label="InvitePage (/invite/:token): preview, then sign up or log in and accept (F5) (M2)" status="planned" milestone="M2" source="docs/M2-DESIGN.md#5-ui-flows-frontend-developer; frontend/src/features/deeds/deedsApi.ts" details="Screen not built: frontend M2 screens wait for the product owner's Figma designs."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="430" y="710" width="250" height="80" as="geometry"/></mxCell></object>
          <object id="deeds-signup" label="Sign up + onboarding (built in M1); existing members can accept too" status="implemented" milestone="M1" source="backend/app/modules/identity/router.py; frontend/src/features/onboarding/OnboardingPage.tsx"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="710" width="250" height="80" as="geometry"/></mxCell></object>
          <object id="deeds-expiry" label="&lt;b&gt;deeds.expire_invites&lt;/b&gt; (every 15 min): pending invites older than 168 h → expired (SKIP LOCKED, batches of 200); deed → unverified, never scored; verification_events(invite_expired)" status="implemented" milestone="M2" source="backend/app/modules/deeds/jobs.py; backend/app/modules/deeds/_invites.py"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1070" y="870" width="250" height="120" as="geometry"/></mxCell></object>
