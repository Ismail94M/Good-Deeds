        <object id="system" label="&lt;b&gt;Good Deeds&lt;/b&gt;&lt;br&gt;[Software system]&lt;br&gt;Mobile-responsive web app: a feed of good deeds witnessed by others, Bangalore launch.&lt;br&gt;&lt;br&gt;&lt;i&gt;Today: accounts, phone OTP, consent, profiles, QR (M1); recording, verifying, editing and withdrawing deeds, password reset (M2); feed, photos, likes, comments, follows, Top, shares, public share page, photo and comment reports with a review queue (M3)&lt;/i&gt;" status="implemented" milestone="M3" source="docs/PRD.md#1; backend/app/main.py; backend/app/modules/registry.py; frontend/src/app/routes.tsx" details="Registered modules: identity, deeds, media, feed. M3 is built on m3-feed (2c7ba38) and awaits PO review. Invites stay switched off (D17). Scoring etc. are M4-M8.">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
            <mxGeometry x="620" y="360" width="360" height="300" as="geometry" />
          </mxCell>
        </object>
        <object id="doer" label="&lt;b&gt;Doer&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Signs up, verifies phone, shows rotating QR + ID + code; sees deeds about them" status="implemented" milestone="M2" source="docs/PRD.md#2; frontend/src/features/qr/MyQrPage.tsx; frontend/src/features/deeds/MyDeedsPage.tsx; backend/app/modules/identity/router.py#/users/me/qr" details="Can sign up (email/Google/Facebook), verify phone, pass the age and consent gate, reset a forgotten password by SMS and show 'My QR'. Since M2 deeds about them are verified by QR scan or typed ID + code; the doer sees only verified ones (D24). Invite acceptance is built but switched off (D17). No points until M4.">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
            <mxGeometry x="60" y="360" width="260" height="80" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="context-e1" value="signs up, shows QR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1333;entryDx=0;entryDy=0;" edge="1" parent="1" source="doer" target="system">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="witness" label="&lt;b&gt;Witness / reporter&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Scans a doer's QR or types ID + code, records the deed, edits or withdraws it" status="implemented" milestone="M2" source="docs/PRD.md#2; backend/app/modules/deeds/router.py; frontend/src/features/report/ReportHubPage.tsx; frontend/src/features/report/ScanDeedPage.tsx; frontend/src/features/deeds/MyDeedsPage.tsx" details="Built end to end in M2 (screens F3 and F6). At most 15 reports about one doer and 150 in total per IST month (D19). Invites are switched off (D17), so a doer who isn't a member must sign up and show their QR.">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
            <mxGeometry x="60" y="470" width="260" height="80" as="geometry" />
          </mxCell>
        </object>
