        <object id="viewer" label="&lt;b&gt;Viewer / member&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Reads the feed; likes, comments, saves, follows, shares; reports photos and comments" status="implemented" milestone="M3" source="docs/PRD.md#2; frontend/src/features/feed/FeedPage.tsx; frontend/src/features/feed/PublicDeedPage.tsx; backend/app/modules/feed/router.py" details="Signed-in users read the feed; social actions need onboarding (D44, Q42). Visitors without an account see only the public share page /d/:id and public profiles; photo reports are open to anyone (IP-limited).">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=36;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
