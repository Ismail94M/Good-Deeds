# Copy to .env for running the API outside Docker. All settings: app/core/config.py
# Product limits (OTP, rate limits, deed caps) are not env vars: they are versioned rows in
# the config_versions table (app/core/runtime_config.py).
# Defaults are production-safe; local development must say so explicitly.
GD_ENV=development
GD_COOKIE_SECURE=false
GD_DATABASE_URL=postgresql+psycopg://gooddeeds:gooddeeds@localhost:5432/gooddeeds
GD_CORS_ORIGINS=["http://localhost:5173"]
GD_WEB_BASE_URL=http://localhost:5173

# Required outside development (long random string): python -c "import secrets; print(secrets.token_urlsafe(48))"
# GD_SECRET_KEY=

# SMS: "console" writes OTP codes to the API log (development only)
GD_SMS_PROVIDER=console

# Social sign-in (buttons are hidden while empty)
GD_GOOGLE_CLIENT_ID=
GD_FACEBOOK_APP_ID=
GD_FACEBOOK_APP_SECRET=

# Object storage (photos). Locally: SeaweedFS from docker-compose (`docker compose up -d storage
# storage-init`); dev keys from infra/seaweedfs/s3.json. Production: GCS XML API + HMAC key.
GD_STORAGE_ENDPOINT_URL=http://localhost:8333
GD_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:8333
GD_STORAGE_REGION=us-east-1
GD_STORAGE_BUCKET=gooddeeds-media
GD_STORAGE_ACCESS_KEY_ID=gooddeeds-dev
GD_STORAGE_SECRET_ACCESS_KEY=gooddeeds-dev-secret-not-for-production
GD_STORAGE_ADDRESSING_STYLE=path
