# Copy to .env for running the API outside Docker. All settings: app/core/config.py
# Defaults are production-safe; local development must say so explicitly.
GD_ENV=development
GD_COOKIE_SECURE=false
GD_DATABASE_URL=postgresql+psycopg://gooddeeds:gooddeeds@localhost:5432/gooddeeds
GD_CORS_ORIGINS=["http://localhost:5173"]
GD_WEB_BASE_URL=http://localhost:5173

# Required outside development (long random string): python -c "import secrets; print(secrets.token_urlsafe(48))"
# GD_SECRET_KEY=

# SMS: "console" writes OTP codes to the API log (development only)
GD_SMS_PROVIDER=console

# Social sign-in (buttons are hidden while empty)
GD_GOOGLE_CLIENT_ID=
GD_FACEBOOK_APP_ID=
GD_FACEBOOK_APP_SECRET=
